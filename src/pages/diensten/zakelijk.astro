---
import BaseLayout from '@/layouts/BaseLayout.astro';

const heroImage = "https://pagesmith-cdn.com/ba5d94c5/images/0c87bcc1e_generated_image-1024.webp";
const detailImage = "https://pagesmith-cdn.com/ba5d94c5/images/e475c3a29_generated_image-1024.webp";

const features = [
  { title: "Bedrijfscontinuïteit", desc: "We minimaliseren overlast. Bouwen buiten werkuren waar nodig." },
  { title: "Kostenbeheersing", desc: "Duidelijke budgetten en geen verrassingen. Jij weet waar je aan toe bent." },
  { title: "Project Management", desc: "Professioneel management van het hele project. Minder stress voor jou." },
  { title: "Kwaliteit & Veiligheid", desc: "Alle norms, alles veilig, alles professioneel." },
  { title: "Flexibiliteit", desc: "Kunnen je aangepaste eisen en schema's accommoderen." },
  { title: "Referenties", desc: "Tientallen tevreden zakelijke klanten in Noord-Holland." },
];

const services = [
  "Kantoorverhoudingen",
  "Winkelruimtes",
  "Praktijkruimtes (arts, tandarts, etc)",
  "Bedrijfspanden",
  "Warehouses en logistiek",
  "Restaurants en cafés",
  "Horecagelegenheden",
  "Flexibele werkruimtes",
];

const processSteps = [
  { step: "01", title: "Intake", desc: "Grondige analyse van je behoeften, planning en budget." },
  { step: "02", title: "Planning", desc: "Een gedetailleerd projectplan met minimale overlast voor je bedrijf." },
  { step: "03", title: "Voorbereiding", desc: "Alle vergunningen en voorbereiding afgehandeld." },
  { step: "04", title: "Bouw", desc: "Professionele uitvoering, vaak buiten werkuren." },
  { step: "05", title: "Oplevering", desc: "Alles klaar en operationeel. Je bedrijf kan direct van start gaan." },
];

const faqs = [
  {
    q: "Kunnen jullie buiten werkuren werken?",
    a: "Ja! Voor kantoren en winkels organiseren we vaak nachtwerk of weekends. Dit minimaliseert overlast voor je bedrijf. Extra kosten zijn minimaal.",
  },
  {
    q: "Hoe zorg je voor bedrijfscontinuïteit?",
    a: "We plannen de werkzaamheden zorgvuldig in overleg met u. Kritieke zones worden buiten kantooruren aangepakt en we zorgen altijd voor veilige doorlooproutes.",
  },
  {
    q: "Wat als het langer duurt dan gepland?",
    a: "We streven altijd naar tijdige oplevering. Mocht er onverwacht vertraging optreden, communiceren we dit direct en stellen gezamenlijk een oplossing voor.",
  },
  {
    q: "Hebben we alle vergunningen nodig?",
    a: "Afhankelijk van de aard van de werkzaamheden. Wij adviseren u over welke vergunningen noodzakelijk zijn en verzorgen de aanvraag volledig namens u.",
  },
  {
    q: "Kunnen we het project faseren?",
    a: "Absoluut. Fasering is voor zakelijke projecten vaak de beste aanpak zodat uw bedrijfsvoering zo min mogelijk hinder ondervindt. We stellen een gefaseerd plan op.",
  },
  {
    q: "Wat voor teams inzetten we in?",
    a: "We werken met ervaren vaste teams die bekend zijn met zakelijke bouwprojecten. Aangevuld met gespecialiseerde onderaannemers voor specifieke werkzaamheden.",
  },
];
---

<BaseLayout
  title="Zakelijke Bouwprojecten Noord-Holland | Kantoor & Bedrijfswerk | A.S.P Aannemersbedrijf"
  description="Professionele zakelijke bouwprojecten in Noord-Holland. A.S.P Aannemersbedrijf realiseert kantoren, winkels, horeca en bedrijfspanden. Minimale overlast, maximale kwaliteit."
>
  <!-- HERO -->
  <section
    id="hero"
    class="relative min-h-[560px] flex items-center"
    style={`padding-top: calc(var(--nav-height) + 80px); padding-bottom: 80px;`}
  >
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url('${heroImage}');`}
    ></div>
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to right, rgba(0,0,0,0.80), rgba(0,0,0,0.50), rgba(0,0,0,0.15));"
    ></div>
    <div class="relative z-10 w-full max-w-[1320px] mx-auto px-6">
      <div class="max-w-[680px]">
        <span
          class="inline-block mb-5 px-4 py-1.5 text-sm font-medium text-white/80 border border-white/30 rounded-full"
        >
          Diensten
        </span>
        <h1
          class="text-[72px] font-bold tracking-tight leading-[1.1] text-white mb-6"
        >
          Zakelijke Bouwprojecten
        </h1>
        <p class="text-[18px] leading-[28px] text-white/75 mb-8 max-w-[560px]">
          Van kantoor tot warehouse. Professionele bouwwerk, met oog voor je bedrijfscontinuïteit.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="#contact"
            class="inline-flex items-center px-8 py-4 rounded-lg text-[14px] font-bold text-white"
            style="background: hsl(211,62%,47%);"
          >
            Neem contact op
          </a>
          <a
            href="tel:0641258151"
            class="inline-flex items-center px-8 py-4 rounded-lg text-[14px] font-bold text-white border-2 border-white/40 hover:border-white/70 transition-colors"
          >
            06 41258151
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="py-[112px]" style="background: hsl(0,0%,100%);">
    <div class="max-w-[1320px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="reveal-left">
          <img
            src={detailImage}
            alt="Zakelijk project detail"
            class="w-full object-cover rounded-lg"
            style="max-height: 520px;"
          />
        </div>
        <div class="reveal-right">
          <span
            class="inline-block mb-4 text-[12px] font-semibold tracking-widest uppercase"
            style="color: hsl(211,62%,47%);"
          >
            BOUW DIE JE BEDRIJF VOORUIT HELPT
          </span>
          <h2
            class="text-[42px] font-semibold leading-[1.2] mb-6"
            style="color: hsl(220,19%,15%);"
          >
            Professioneel, punctueel en zonder overlast
          </h2>
          <p class="text-[16px] leading-[26px] mb-4" style="color: hsl(219,10%,45%);">
            Een goed werkplek draagt bij aan productiviteit en sfeer. Of je nu een kantoor wilt uitbreiden, een nieuwe vestiging wilt openen, of je horecazaak wilt renoveren — wij zorgen voor professionele, punctuele uitvoering.
          </p>
          <p class="text-[16px] leading-[26px] mb-8" style="color: hsl(219,10%,45%);">
            A.S.P werkt graag met bedrijven. We snappen dat downtime geld kost en dat je bedrijf draaiende moet blijven.
          </p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {["Projectmanagement", "Minimale overlast", "Duidelijke planning", "Professionele teams"].map((item) => (
              <li class="flex items-center gap-3">
                <span
                  class="flex-shrink-0 w-5 h-5 rounded-full flex items-center justify-center"
                  style="background: hsl(142,76%,36%);"
                >
                  <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 12 12">
                    <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="text-[14px] font-medium" style="color: hsl(220,19%,15%);">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="py-[112px]" style="background: rgba(240,242,244,0.5);">
    <div class="max-w-[1320px] mx-auto px-6">
      <div class="text-center mb-14 reveal">
        <span
          class="inline-block mb-4 text-[12px] font-semibold tracking-widest uppercase"
          style="color: hsl(211,62%,47%);"
        >
          WAT WE VOOR BEDRIJVEN DOEN
        </span>
        <h2 class="text-[42px] font-normal" style="color: hsl(220,19%,15%);">
          Zakelijke diensten
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {services.map((service) => (
          <div
            class="flex items-center gap-3 p-4 rounded-lg bg-white border reveal"
            style="border-color: hsl(210,15%,90%);"
          >
            <span
              class="flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center"
              style="background: hsl(211,62%,47%); color: white;"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 16 16">
                <path d="M3 8.5l3.5 3.5 6.5-6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="text-[14px] font-medium" style="color: hsl(220,19%,15%);">{service}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-[112px]" style="background: hsl(223,42%,18%);">
    <div class="max-w-[1320px] mx-auto px-6">
      <div class="text-center mb-14 reveal">
        <span
          class="inline-block mb-4 text-[12px] font-semibold tracking-widest uppercase"
          style="color: hsl(211,62%,47%);"
        >
          HOE WE ZAKELIJKE PROJECTEN AANPAKKEN
        </span>
        <h2 class="text-[42px] font-normal text-white">Van intake tot oplevering</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {processSteps.map((s, i) => (
          <div class="reveal" style={`transition-delay: ${i * 0.1}s;`}>
            <div
              class="text-[40px] font-bold mb-3 leading-none"
              style="color: hsl(211,62%,47%);"
            >
              {s.step}
            </div>
            <h3 class="text-[16px] font-bold text-white mb-2">{s.title}</h3>
            <p class="text-[13px] leading-[20px]" style="color: rgba(255,255,255,0.6);">{s.desc}</p>
          </div>
        ))}
      </div>

      <!-- WHY features -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-16">
        {features.map((f, i) => (
          <div
            class="p-6 rounded-lg border reveal"
            style={`border-color: hsl(223,42%,28%); background: hsl(223,42%,22%); transition-delay: ${i * 0.1}s;`}
          >
            <div
              class="w-10 h-10 rounded-lg flex items-center justify-center mb-4"
              style="background: hsl(211,62%,47%);"
            >
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 20 20">
                <path d="M4 10l4 4 8-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="text-[16px] font-bold text-white mb-2">{f.title}</h3>
            <p class="text-[14px] leading-[22px]" style="color: rgba(255,255,255,0.6);">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-[112px]" style="background: hsl(0,0%,100%);">
    <div class="max-w-[860px] mx-auto px-6">
      <div class="text-center mb-14 reveal">
        <span
          class="inline-block mb-4 text-[12px] font-semibold tracking-widest uppercase"
          style="color: hsl(211,62%,47%);"
        >
          VEELGESTELDE VRAGEN
        </span>
        <h2 class="text-[42px] font-semibold" style="color: hsl(220,19%,15%);">
          Alles wat je moet weten
        </h2>
      </div>
      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details
            class="group border rounded-lg overflow-hidden reveal"
            style={`border-color: hsl(210,15%,90%); transition-delay: ${i * 0.07}s;`}
            open={i === 0}
          >
            <summary
              class="flex items-center justify-between p-5 cursor-pointer list-none font-semibold text-[15px]"
              style="color: hsl(220,19%,15%);"
            >
              <span>{faq.q}</span>
              <svg
                class="w-5 h-5 flex-shrink-0 transition-transform group-open:rotate-180"
                style="color: hsl(211,62%,47%);"
                fill="none"
                viewBox="0 0 20 20"
              >
                <path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="px-5 pb-5 text-[14px] leading-[22px]" style="color: hsl(219,10%,45%);">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" class="py-[80px]" style="background: hsl(211,62%,47%);">
    <div class="max-w-[1320px] mx-auto px-6 text-center reveal">
      <h2 class="text-[42px] font-bold text-white mb-4">Zakelijk bouwproject?</h2>
      <p class="text-[18px] text-white/80 mb-8 max-w-[560px] mx-auto">
        Laten we snel met elkaar spreken over jouw plannen en mogelijkheden.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="tel:0641258151"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-lg text-[15px] font-bold bg-white"
          style="color: hsl(211,62%,47%);"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
            <path d="M3 5a2 2 0 012-2h1.5a1 1 0 01.98.8l.72 3.58a1 1 0 01-.29.94l-1.1 1.1a11.05 11.05 0 005.75 5.75l1.1-1.1a1 1 0 01.94-.29l3.58.72a1 1 0 01.8.98V15a2 2 0 01-2 2C8.716 17 3 11.284 3 5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          06 41258151
        </a>
        <a
          href="mailto:info@asp-aannemersbedrijf.nl"
          class="inline-flex items-center px-8 py-4 rounded-lg text-[15px] font-bold text-white border-2 border-white/50 hover:border-white transition-colors"
        >
          Stuur een bericht
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
