---
import BaseLayout from '@/layouts/BaseLayout.astro';

const heroImage = "https://pagesmith-cdn.com/ba5d94c5/images/fb0eae035_generated_image-1024.webp";
const detailImage = "https://pagesmith-cdn.com/ba5d94c5/images/ee4cc7de3_generated_image-1024.webp";

const features = [
  { title: "Stucwerk", desc: "Glad, professioneel stucwerk. Perfecte voorbereiding voor schilderwerk." },
  { title: "Schilderwerk", desc: "Duurzame laklagen, schoon werk, alle oppervlakken perfect afgewerkt." },
  { title: "Vloeren", desc: "Tegelwerk, parket, pvc — alles vakkundig aangebracht en afgewerkt." },
  { title: "Houtwerk", desc: "Trappen, deuren, kasten — alles mooi en functioneel." },
  { title: "Installaties", desc: "Alle installaties netjes verwerkt en afgewerkt." },
  { title: "Detail & Finish", desc: "De puntjes op de i — dat onderscheidt goed werk van mooi werk." },
];

const services = [
  "Stucwerk en pleisterwerk",
  "Interieur- en exterieur schilderwerk",
  "Vloeren en tegelwerk",
  "Deur- en raamafwerking",
  "Trapwerk en houtwerk",
  "Plafond afwerking",
  "Kasten en inbouwwerk",
  "Deuren en sloten installatie",
];

const processSteps = [
  { step: "01", title: "Voorbereiding", desc: "Ondergrond reinigen en voorbereiden. Dit is de basis van goed afbouwwerk." },
  { step: "02", title: "Vakkundig Uitvoeren", desc: "Stucen, schilderen, leggen — alles volgens vakstandaarden." },
  { step: "03", title: "Inspectie & Finish", desc: "Controle op kwaliteit en perfectioneren tot alles mooi is." },
];

const faqs = [
  {
    q: "Hoe belangrijk is goede voorbereiding voor afbouw?",
    a: "Essentieel! Slechte voorbereiding leidt tot slechte resultaten. Wij reinigen, polijsten en bereiden alles perfect voor stucwerk of schilderwerk. Dit is waar kwaliteit ontstaat.",
  },
  {
    q: "Hoeveel lagen verf/primer zijn nodig?",
    a: "Afhankelijk van het oppervlak en de ondergrond, minimaal twee lagen na een primer. Voor optimale dekking en duurzaamheid adviseren we altijd een grondlaag plus twee afwerklagen.",
  },
  {
    q: "Wat soort stucwerk kan je doen?",
    a: "We doen zowel glad stucwerk voor schilderwerk als structuurstuc voor decoratieve doeleinden. We adviseren u over de beste optie voor uw situatie en stijl.",
  },
  {
    q: "Kunnen jullie ook schilderen?",
    a: "Absoluut. Schilderwerk is een van onze kernactiviteiten — zowel interieur als exterieur. We werken met hoogwaardige verfsoorten voor een langdurig en mooi resultaat.",
  },
  {
    q: "Hoeveel kost afbouw gemiddeld?",
    a: "Kosten hangen af van de omvang en de gewenste afwerking. Na een vrijblijvende inspectie geven we een gedetailleerde en transparante offerte zonder verborgen kosten.",
  },
  {
    q: "Hoe lang blijft het mooi?",
    a: "Met hoogwaardige materialen en een goede voorbereiding gaat schilderwerk gemiddeld 8–10 jaar mee. Stucwerk heeft bij goed onderhoud een nog langere levensduur.",
  },
];
---

<BaseLayout
  title="Afbouw & Finishing Noord-Holland | Schilderen & Stucen | A.S.P Aannemersbedrijf"
  description="Professionele afbouw in Noord-Holland. A.S.P verzorgt stucwerk, schilderwerk, vloeren, tegelwerk en meer. De puntjes op de i, met passie en aandacht voor detail."
>
  <!-- HERO -->
  <section
    id="hero"
    class="relative min-h-[560px] flex items-center"
    style={`padding-top: calc(var(--nav-height) + 80px); padding-bottom: 80px;`}
  >
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url('${heroImage}');`}
    ></div>
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to right, rgba(0,0,0,0.80), rgba(0,0,0,0.50), rgba(0,0,0,0.15));"
    ></div>
    <div class="relative z-10 w-full max-w-[1320px] mx-auto px-6">
      <div class="max-w-[680px]">
        <span
          class="inline-block mb-5 px-4 py-1.5 text-sm font-medium text-white/80 border border-white/30 rounded-full"
        >
          Diensten
        </span>
        <h1
          class="text-[72px] font-bold tracking-tight leading-[1.1] text-white mb-6"
        >
          Afbouw & Finishing
        </h1>
        <p class="text-[18px] leading-[28px] text-white/75 mb-8 max-w-[560px]">
          De puntjes op de i. Stucwerk, schilderwerk, vloeren, houtwerk — alles afgewerkt met passie en detail.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="#contact"
            class="inline-flex items-center px-8 py-4 rounded-lg text-[14px] font-bold text-white"
            style="background: hsl(211,62%,47%);"
          >
            Neem contact op
          </a>
          <a
            href="tel:0641258151"
            class="inline-flex items-center px-8 py-4 rounded-lg text-[14px] font-bold text-white border-2 border-white/40 hover:border-white/70 transition-colors"
          >
            06 41258151
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="py-[112px]" style="background: hsl(0,0%,100%);">
    <div class="max-w-[1320px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="reveal-left">
          <img
            src={detailImage}
            alt="Afbouw detail"
            class="w-full object-cover rounded-lg"
            style="max-height: 520px;"
          />
        </div>
        <div class="reveal-right">
          <span
            class="inline-block mb-4 text-[12px] font-semibold tracking-widest uppercase"
            style="color: hsl(211,62%,47%);"
          >
            VAN ROUW NAAR MOOI
          </span>
          <h2
            class="text-[42px] font-semibold leading-[1.2] mb-6"
            style="color: hsl(220,19%,15%);"
          >
            Waar jouw huis zijn karakter krijgt
          </h2>
          <p class="text-[16px] leading-[26px] mb-4" style="color: hsl(219,10%,45%);">
            Afbouw is waar je huis echt zijn karakter krijgt. Niet alleen functioneel, maar ook mooi. Goed stucwerk, goed schilderwerk, goede vloeren — dat maakt het verschil.
          </p>
          <p class="text-[16px] leading-[26px] mb-8" style="color: hsl(219,10%,45%);">
            Onze teams hebben jarenlange ervaring met alles van stucen tot schilderen. We werken schoon, zorgvuldig, en letten op elk detail. Dit is ons vak.
          </p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {["Gladde, perfecte muren", "Duurzame verfwerk", "Professionele voorbereiding", "Oog voor detail"].map((item) => (
              <li class="flex items-center gap-3">
                <span
                  class="flex-shrink-0 w-5 h-5 rounded-full flex items-center justify-center"
                  style="background: hsl(142,76%,36%);"
                >
                  <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 12 12">
                    <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="text-[14px] font-medium" style="color: hsl(220,19%,15%);">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="py-[112px]" style="background: rgba(240,242,244,0.5);">
    <div class="max-w-[1320px] mx-auto px-6">
      <div class="text-center mb-14 reveal">
        <span
          class="inline-block mb-4 text-[12px] font-semibold tracking-widest uppercase"
          style="color: hsl(211,62%,47%);"
        >
          ONZE AFBOUWSERVICES
        </span>
        <h2 class="text-[42px] font-normal" style="color: hsl(220,19%,15%);">
          Alles voor de perfecte afwerking
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {services.map((service) => (
          <div
            class="flex items-center gap-3 p-4 rounded-lg bg-white border reveal"
            style="border-color: hsl(210,15%,90%);"
          >
            <span
              class="flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center"
              style="background: hsl(211,62%,47%); color: white;"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 16 16">
                <path d="M3 8.5l3.5 3.5 6.5-6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="text-[14px] font-medium" style="color: hsl(220,19%,15%);">{service}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-[112px]" style="background: hsl(223,42%,18%);">
    <div class="max-w-[1320px] mx-auto px-6">
      <div class="text-center mb-14 reveal">
        <span
          class="inline-block mb-4 text-[12px] font-semibold tracking-widest uppercase"
          style="color: hsl(211,62%,47%);"
        >
          HOE WE AFBOUWEN
        </span>
        <h2 class="text-[42px] font-normal text-white">Onze aanpak</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {processSteps.map((s, i) => (
          <div class="reveal" style={`transition-delay: ${i * 0.15}s;`}>
            <div
              class="text-[48px] font-bold mb-4 leading-none"
              style="color: hsl(211,62%,47%);"
            >
              {s.step}
            </div>
            <h3 class="text-[18px] font-bold text-white mb-3">{s.title}</h3>
            <p class="text-[14px] leading-[22px]" style="color: rgba(255,255,255,0.6);">{s.desc}</p>
          </div>
        ))}
      </div>

      <!-- Quality cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-16">
        {features.map((f, i) => (
          <div
            class="p-6 rounded-lg border reveal"
            style={`border-color: hsl(223,42%,28%); background: hsl(223,42%,22%); transition-delay: ${i * 0.1}s;`}
          >
            <div
              class="w-10 h-10 rounded-lg flex items-center justify-center mb-4"
              style="background: hsl(211,62%,47%);"
            >
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 20 20">
                <path d="M4 10l4 4 8-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="text-[16px] font-bold text-white mb-2">{f.title}</h3>
            <p class="text-[14px] leading-[22px]" style="color: rgba(255,255,255,0.6);">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-[112px]" style="background: hsl(0,0%,100%);">
    <div class="max-w-[860px] mx-auto px-6">
      <div class="text-center mb-14 reveal">
        <span
          class="inline-block mb-4 text-[12px] font-semibold tracking-widest uppercase"
          style="color: hsl(211,62%,47%);"
        >
          VEELGESTELDE VRAGEN
        </span>
        <h2 class="text-[42px] font-semibold" style="color: hsl(220,19%,15%);">
          Alles wat je moet weten
        </h2>
      </div>
      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details
            class="group border rounded-lg overflow-hidden reveal"
            style={`border-color: hsl(210,15%,90%); transition-delay: ${i * 0.07}s;`}
            open={i === 0}
          >
            <summary
              class="flex items-center justify-between p-5 cursor-pointer list-none font-semibold text-[15px]"
              style="color: hsl(220,19%,15%);"
            >
              <span>{faq.q}</span>
              <svg
                class="w-5 h-5 flex-shrink-0 transition-transform group-open:rotate-180"
                style="color: hsl(211,62%,47%);"
                fill="none"
                viewBox="0 0 20 20"
              >
                <path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="px-5 pb-5 text-[14px] leading-[22px]" style="color: hsl(219,10%,45%);">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" class="py-[80px]" style="background: hsl(211,62%,47%);">
    <div class="max-w-[1320px] mx-auto px-6 text-center reveal">
      <h2 class="text-[42px] font-bold text-white mb-4">Afbouwwerk nodig?</h2>
      <p class="text-[18px] text-white/80 mb-8 max-w-[560px] mx-auto">
        Van schilderwerk tot volledige afbouw. Wij zorgen dat je huis er perfect uitziet.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="tel:0641258151"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-lg text-[15px] font-bold bg-white"
          style="color: hsl(211,62%,47%);"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
            <path d="M3 5a2 2 0 012-2h1.5a1 1 0 01.98.8l.72 3.58a1 1 0 01-.29.94l-1.1 1.1a11.05 11.05 0 005.75 5.75l1.1-1.1a1 1 0 01.94-.29l3.58.72a1 1 0 01.8.98V15a2 2 0 01-2 2C8.716 17 3 11.284 3 5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          06 41258151
        </a>
        <a
          href="mailto:info@asp-aannemersbedrijf.nl"
          class="inline-flex items-center px-8 py-4 rounded-lg text-[15px] font-bold text-white border-2 border-white/50 hover:border-white transition-colors"
        >
          Stuur een bericht
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
