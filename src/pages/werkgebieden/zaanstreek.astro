const voordelen = [
  {
    title: 'Lokale expertise',
    description: 'We kennen de Zaanstreek sinds 1999. Alle gemeentelijke vereisten, bouwstandaarden en lokale regelgeving — we beheersen het.',
  },
  {
    title: 'Betrouwbaarheid',
