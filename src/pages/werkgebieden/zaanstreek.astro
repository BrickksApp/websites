  {
    question: 'Wat is jullie werkgebied exact?',
    answer: 'Ons werkgebied omvat heel Noord-Holland, met de nadruk op de Zaanstreek (Zaandam, Wormerveer, Krommenie, Assendelft), Amsterdam en omstreken, Haarlem, en de Gooi & Vechtstreek.',
  },
  {
    question: 'Hebben jullie referenties in de Zaanstreek?',
    answer: 'Ja, we hebben tientallen tevreden klanten in de Zaanstreek. Vraag ons gerust naar referentieprojecten in uw buurt. We kunnen ook contact leggen met eerdere opdrachtgevers die bereid zijn hun ervaringen te delen.',
  },
  {
    question: 'Hoe contacteer ik jullie voor een offerte in Zaandam?',
    answer: 'U kunt ons bellen op 06 41258151, een e-mail sturen naar info@asp-aannemersbedrijf.nl, of het contactformulier op onze website invullen. We reageren doorgaans binnen 24 uur met een vrijblijvende offerte.',
  },
];
---

<BaseLayout
  title="Bouwbedrijf Zaandam, Wormerveer | Nieuwbouw & Renovatie | A.S.P Aannemersbedrijf"
  description="A.S.P Aannemersbedrijf actief in de Zaanstreek. Meer dan 25 jaar ervaring in Zaandam, Wormerveer en omgeving. Nieuwbouw, renovatie en zakelijke projecten."
>
  <WerkgebiedHero
    title="Bouw & Renovatie in Zaandam"
    subtitle="Meer dan 25 jaar ervaring in de Zaanstreek. Van Zaandam tot Assendelft — we kennen elke straat en elke gemeente."
    location="Zaanstreek & Noord-Holland"
    image="https://pagesmith-cdn.com/ba5d94c5/images/411cc44d8_generated_image-1024.webp"
    imageAlt="Nieuwbouw in Zaandam"
    ctaText="Vraag offerte aan"
    ctaHref="#footer"
  />

  <WerkgebiedDiensten
    heading="Onze diensten in de Zaanstreek"
    diensten={diensten}
  />

  <WerkgebiedVoordelen
    heading="Waarom A.S.P voor uw project in de Zaanstreek?"
    voordelen={voordelen}
  />

  <WerkgebiedFAQ faqs={faqs} />

  <WerkgebiedCTA
    city="Zaandam"
    heading="Klaar om te starten in Zaandam?"
    subtext="Neem vandaag contact op. Wij bespreken je wensen, budget en planning."
  />
</BaseLayout>
