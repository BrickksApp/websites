const faqs = [
  {
    question: 'Werken jullie in Zaandam, Wormerveer en omliggende dorpen?',
    answer: 'Ja, de Zaanstreek is één van onze kerngebieden met meer dan 25 jaar ervaring. Van nieuwbouw tot renovatie — we kennen de regio en de gemeente vereisten perfect. We zijn actief in Zaandam, Wormerveer, Krommenie, Assendelft en omliggende dorpen.',
  },
  {
    question: 'Hoe lang duren bouwprojecten in de Zaanstreek gemiddeld?',
    answer: 'De duur is afhankelijk van de omvang en complexiteit van het project. Een badkamerrenovatie duurt typisch 1-2 weken, terwijl een nieuwbouwwoning 6-12 maanden kan duren. We stellen altijd een gedetailleerde planning op bij de start van het project.',
  },
  {
    question: 'Bieden jullie ook zakelijke projecten in Zaandam aan?',
    answer: 'Absoluut. We voeren regelmatig zakelijke projecten uit in de Zaanstreek, waaronder kantoorverbouwingen, winkelrenovaties en bedrijfsgebouwen. Neem contact op voor een zakelijke offerte.',
