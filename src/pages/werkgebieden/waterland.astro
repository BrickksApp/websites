    image="https://pagesmith-cdn.com/ba5d94c5/images/1ce5eb049_generated_image-1024.webp"
    imageAlt="Vakkundig bouwen in Waterland"
    ctaText="Vraag offerte aan"
    ctaHref="#footer"
  />

  <WerkgebiedDiensten
    heading="Bouwdiensten in Waterland"
    diensten={diensten}
  />

  <WerkgebiedVoordelen
    heading="Waarom A.S.P voor uw project in Waterland?"
    voordelen={voordelen}
  />

  <WerkgebiedFAQ faqs={faqs} />

  <WerkgebiedCTA
    city="Waterland"
    heading="Bouwproject in Waterland?"
    subtext="Laat ons uw dorp helpen — met vakmanschap en respect voor het karakter van de regio."
  />
