    image="https://pagesmith-cdn.com/ba5d94c5/images/f7fc278ff_generated_image-1024.webp"
    imageAlt="Bouwproject in Gouda"
    ctaText="Offerte aanvragen"
    ctaHref="#footer"
  />

  <WerkgebiedDiensten
    heading="Volledige bouwservice Gouda"
    diensten={diensten}
  />

  <WerkgebiedVoordelen
    heading="Waarom A.S.P voor uw project in Gouda?"
    voordelen={voordelen}
  />

