---
---

<section class="relative flex items-end" style="min-height: 560px; background-color: hsl(223, 42%, 18%);">
  <div class="absolute inset-0 overflow-hidden">
    <img
      src="https://pagesmith-cdn.com/ba5d94c5/images/c0194bddf_generated_image-1024.webp"
      alt="Bouw in Utrecht"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(0,0,0,0.82), rgba(0,0,0,0.55), rgba(0,0,0,0.15));"></div>
  </div>

  <div class="relative z-10 w-full max-w-[1320px] mx-auto px-6" style="padding-top: 160px; padding-bottom: 90px;">
    <span class="inline-block text-[13px] font-medium border border-white/30 text-white/80 px-4 py-1.5 rounded-full mb-4">
      Utrecht &amp; Utrechtse Heuvelrug
    </span>
    <h1 class="text-[64px] font-bold text-white leading-[1.1] tracking-tight max-w-[720px] mb-5">
      Bouw in groeiend Utrecht
    </h1>
    <p class="text-[18px] leading-[28px] max-w-[540px] mb-8" style="color: rgba(255,255,255,0.75);">
      Nieuwbouw, renovatie en zakelijke projecten in dynamisch Utrecht en omgeving.
    </p>
    <a
      href="#contact"
      class="inline-flex items-center font-bold text-[14px] text-white px-8 py-4 rounded-lg transition-colors"
      style="background-color: hsl(211, 62%, 47%);"
    >
      Bel voor offerte
    </a>
  </div>
</section>
