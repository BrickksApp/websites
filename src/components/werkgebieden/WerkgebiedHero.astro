---
export interface Props {
  title: string;
  subtitle: string;
  location: string;
  image: string;
  imageAlt: string;
  ctaText: string;
  ctaHref: string;
}

const { title, subtitle, location, image, imageAlt, ctaText, ctaHref } = Astro.props;
---

<section
  id="hero"
  class="relative min-h-[560px] flex items-center"
  style={`background: hsl(223, 42%, 18%);`}
  data-ps="werkgebied-hero"
>
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`background-image: url('${image}');`}
  ></div>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to right, rgba(0,0,0,0.80), rgba(0,0,0,0.55), rgba(0,0,0,0.25));"
  ></div>

  <div class="relative z-10 w-full max-w-[1320px] mx-auto px-6 pt-[140px] pb-[100px]">
    <div class="max-w-[700px]">
      <span class="inline-block text-[13px] font-medium tracking-widest uppercase text-[hsl(211,62%,70%)] mb-4">
        {location}
      </span>
      <h1 class="text-[64px] font-bold tracking-tight leading-[1.1] text-white mb-6">
        {title}
      </h1>
      <p class="text-[18px] leading-[28px] text-white/70 max-w-[560px] mb-8">
        {subtitle}
      </p>
      <a
        href={ctaHref}
        class="inline-block bg-[hsl(211,62%,47%)] text-white font-bold rounded-lg px-8 py-4 text-[15px] hover:bg-[hsl(211,62%,37%)] transition-colors"
      >
        {ctaText}
      </a>
    </div>
  </div>
</section>
