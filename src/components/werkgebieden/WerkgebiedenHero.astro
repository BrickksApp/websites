---
---
<section class="relative flex items-center min-h-[60vh]" style="background-color: hsl(223, 42%, 18%);">
  <div class="absolute inset-0">
    <img
      src="https://pagesmith-cdn.com/ba5d94c5/images/fa66788f8_generated_image-1024.webp"
      alt="Bouwwerken Amsterdam regio"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(0,0,0,0.78), rgba(0,0,0,0.45), rgba(0,0,0,0.15));"></div>
  </div>
  <div class="relative z-10 w-full max-w-[1320px] mx-auto px-6 pt-[160px] pb-[100px]">
    <div class="max-w-[700px] reveal">
      <span class="inline-block text-[hsl(211,62%,47%)] text-sm font-semibold uppercase tracking-widest mb-4">Ons Werkgebied</span>
      <h1 class="text-[72px] font-bold text-white leading-[1.1] tracking-tight mb-6">Bouwwerken in Amsterdam, Utrecht & Omstreken</h1>
      <p class="text-[18px] leading-[28px] mb-8" style="color: rgba(255,255,255,0.7);">
        A.S.P Aannemersbedrijf is actief in alle gebieden tot 60km rond Amsterdam. Van nieuwbouw tot renovatie — we realiseren projecten in jouw buurt.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="tel:0641258151"
          class="inline-flex items-center justify-center gap-2 text-white font-bold rounded-lg px-8 py-4 text-[16px] transition-colors"
          style="background-color: hsl(211, 62%, 47%);"
          onmouseover="this.style.backgroundColor='hsl(211,62%,37%)'"
          onmouseout="this.style.backgroundColor='hsl(211,62%,47%)'"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          06 41258151
        </a>
        <a
          href="/Werkgebieden/#footer"
          class="inline-flex items-center justify-center gap-2 font-bold rounded-lg px-8 py-4 text-[16px] border-2 transition-colors"
          style="border-color: rgba(255,255,255,0.5); color: white;"
          onmouseover="this.style.backgroundColor='rgba(255,255,255,0.1)'"
          onmouseout="this.style.backgroundColor='transparent'"
        >
          Neem contact op
        </a>
      </div>
    </div>
  </div>
</section>
