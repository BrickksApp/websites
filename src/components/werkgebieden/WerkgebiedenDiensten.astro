---
const services = [
  { title: "Nieuwbouw", link: "/diensten/nieuwbouw" },
  { title: "Ruwbouw", link: "/diensten/ruwbouw" },
  { title: "Renovatie", link: "/diensten/renovatie" },
  { title: "Aan- & Uitbouw", link: "/diensten/aan-uitbouw" },
  { title: "Afbouw", link: "/diensten/afbouw" },
  { title: "Zakelijke Bouw", link: "/diensten/zakelijk" },
];
---
<section class="py-[112px]" style="background-color: hsl(0, 0%, 100%);">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="text-center mb-10 reveal">
      <h2 class="text-[42px] font-semibold mb-3" style="color: hsl(220, 19%, 15%);">Onze Diensten in het Werkgebied</h2>
      <p class="text-[18px]" style="color: hsl(219, 10%, 45%);">
        Alle diensten beschikbaar in Amsterdam, Haarlem, Utrecht, Gouda en omgeving
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {services.map((service, i) => (
        <a
          href={service.link}
          class={`block p-6 bg-white border-2 rounded-lg hover:shadow-md transition-all group reveal reveal-delay-${(i % 3) + 1}`}
          style="border-color: hsl(210, 15%, 90%);"
          onmouseover="this.style.borderColor='hsl(211,62%,47%)'"
          onmouseout="this.style.borderColor='hsl(210,15%,90%)'"
        >
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-[18px] font-bold mb-1 group-hover:text-[hsl(211,62%,47%)] transition-colors" style="color: hsl(220, 19%, 15%);">{service.title}</h3>
              <p class="text-[14px]" style="color: hsl(219, 10%, 45%);">Professioneel en betrouwbaar in alle steden van ons werkgebied.</p>
            </div>
            <svg class="w-5 h-5 flex-shrink-0 ml-4 transition-transform group-hover:translate-x-1" style="color: hsl(211, 62%, 47%);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
