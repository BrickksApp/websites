---
export interface Props {
  city: string;
  heading: string;
  subtext?: string;
}

const { city, heading, subtext } = Astro.props;
---

<section id="footer" class="py-[112px] bg-white">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="max-w-[760px] mx-auto text-center">
      <span class="inline-block text-[13px] font-semibold tracking-widest uppercase text-[hsl(211,62%,47%)] mb-4">
        BOUWPROJECT IN {city.toUpperCase()}?
      </span>
      <h2 class="text-[42px] font-semibold text-[hsl(220,19%,15%)] mb-4">
        {heading}
      </h2>
      {subtext && (
        <p class="text-[16px] leading-[26px] text-[hsl(219,10%,45%)] mb-10">{subtext}</p>
      )}

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="tel:0641258151"
          class="inline-flex items-center gap-3 bg-[hsl(211,62%,47%)] text-white font-bold rounded-lg px-8 py-4 text-[15px] hover:bg-[hsl(211,62%,37%)] transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          06 41258151
        </a>
        <a
          href="mailto:info@asp-aannemersbedrijf.nl"
          class="inline-flex items-center gap-3 border-2 border-[hsl(211,62%,47%)] text-[hsl(211,62%,47%)] font-bold rounded-lg px-8 py-4 text-[15px] hover:bg-[hsl(211,62%,47%)] hover:text-white transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Stuur een email
        </a>
      </div>

      <div class="mt-10 pt-8 border-t border-[hsl(210,15%,90%)] flex flex-col sm:flex-row items-center justify-center gap-6 text-[14px] text-[hsl(219,10%,45%)]">
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[hsl(142,76%,36%)]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Offerte binnen 24 uur
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[hsl(142,76%,36%)]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Gratis adviesgesprek
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[hsl(142,76%,36%)]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Geen verplichtingen
        </span>
      </div>
    </div>
  </div>
</section>
