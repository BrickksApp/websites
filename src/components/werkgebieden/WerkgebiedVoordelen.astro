---
export interface Voordeel {
  title: string;
  description: string;
}

export interface Props {
  heading: string;
  intro?: string;
  voordelen: Voordeel[];
}

const { heading, intro, voordelen } = Astro.props;

const icons = [
  "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
  "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z",
  "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  "M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064",
];
---

<section id="voordelen" class="py-[112px] bg-white">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="mb-12 max-w-[640px]">
      <span class="text-[13px] font-semibold tracking-widest uppercase text-[hsl(211,62%,47%)]">
        WAAROM A.S.P
      </span>
      <h2 class="text-[42px] font-normal text-[hsl(220,19%,15%)] mt-2">
        {heading}
      </h2>
      {intro && (
        <p class="text-[16px] leading-[26px] text-[hsl(219,10%,45%)] mt-4">{intro}</p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {voordelen.map((v, i) => (
        <div class="flex gap-5">
          <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[hsl(211,62%,47%)]/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-[hsl(211,62%,47%)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={icons[i % icons.length]} />
            </svg>
          </div>
          <div>
            <h3 class="text-[18px] font-bold text-[hsl(220,19%,15%)] mb-2">{v.title}</h3>
            <p class="text-[15px] leading-[24px] text-[hsl(219,10%,45%)]">{v.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
