---
<section class="relative flex items-center min-h-[60vh]" style="background-color: hsl(223, 42%, 18%);">
  <div class="absolute inset-0">
    <img
      src="https://pagesmith-cdn.com/ba5d94c5/images/d5002cb36_Foto04-05-2026om1824-1024.webp"
      alt="Diensten"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(0,0,0,0.75), rgba(0,0,0,0.45), rgba(0,0,0,0.15));"></div>
  </div>
  <div class="relative z-10 w-full max-w-[1320px] mx-auto px-6 pt-[160px] pb-[100px]">
    <div class="max-w-[640px] reveal">
      <span class="inline-block text-[hsl(211,62%,47%)] text-sm font-semibold uppercase tracking-widest mb-4">Wat Wij Doen</span>
      <h1 class="text-[72px] font-bold text-white leading-[1.1] tracking-tight mb-6">Onze Diensten</h1>
      <p class="text-[18px] leading-[28px]" style="color: rgba(255,255,255,0.7);">
        Van fundering tot finishing touch — volledige bouwoplossingen voor particulier en zakelijk
      </p>
    </div>
  </div>
</section>
