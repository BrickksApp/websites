<section class="py-[112px]" style="background-color: hsl(0, 0%, 100%);">
  <div class="max-w-[1320px] mx-auto px-6 text-center reveal">
    <h2 class="text-[42px] font-semibold mb-4" style="color: hsl(220, 19%, 15%);">Welke dienst zoekt u?</h2>
    <p class="text-[18px] mb-8 max-w-[560px] mx-auto" style="color: hsl(219, 10%, 45%);">
      Kies een dienst hierboven of neem direct contact met ons op.
    </p>
    <a
      href="/Diensten/#footer"
      class="inline-block text-white font-bold rounded-lg px-8 py-4 text-[16px] transition-colors"
      style="background-color: hsl(211, 62%, 47%);"
      onmouseover="this.style.backgroundColor='hsl(211,62%,37%)'"
      onmouseout="this.style.backgroundColor='hsl(211,62%,47%)'"
    >
      Doe je aanvraag
    </a>
  </div>
