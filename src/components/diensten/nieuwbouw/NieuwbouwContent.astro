---
---

<!-- Overview Section -->
<section class="py-[112px] bg-white">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-[13px] font-semibold tracking-widest uppercase mb-4" style="color: hsl(211, 62%, 47%);">OVER NIEUWBOUW</p>
        <h2 class="text-[42px] font-semibold leading-[1.2] mb-6" style="color: hsl(220, 19%, 15%);">Jouw droom bouwen wij</h2>
        <p class="text-[18px] leading-[28px] mb-5" style="color: hsl(219, 10%, 45%);">
          Nieuwbouw is meer dan alleen muren bouwen. Het gaat om het creëren van een plek waar gezinnen gelukkig zijn, waar herinneringen ontstaan. A.S.P Aannemersbedrijf heeft meer dan 25 jaar ervaring in het realiseren van droomhuizen in Noord-Holland.
        </p>
        <p class="text-[18px] leading-[28px] mb-8" style="color: hsl(219, 10%, 45%);">
          Van grondwerk tot sleuteloverdracht — we begeleiden je door elke stap. Met aandacht voor detail, moderne technieken en duurzame materialen.
        </p>
        <ul class="space-y-3">
          {['Modern en energiezuinig', 'Volledig project management', 'Op tijd en binnen budget', 'Duurzame oplossingen'].map(item => (
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 flex-shrink-0" style="color: hsl(142, 76%, 36%);" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-[16px] font-medium" style="color: hsl(220, 19%, 15%);">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <img
          src="https://pagesmith-cdn.com/ba5d94c5/images/29bd12e58_generated_image-1024.webp"
          alt="Nieuwbouw huis Noord-Holland"
          class="w-full rounded-lg object-cover"
          style="max-height: 520px;"
        />
      </div>
    </div>
  </div>
</section>

<!-- Includes Section -->
<section class="py-[112px]" style="background: rgba(240, 242, 244, 0.5);">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="text-center mb-14">
      <p class="text-[13px] font-semibold tracking-widest uppercase mb-3" style="color: hsl(211, 62%, 47%);">WAT IS INBEGREPEN</p>
      <h2 class="text-[42px] font-semibold leading-[1.2]" style="color: hsl(220, 19%, 15%);">Wat is inbegrepen in nieuwbouw?</h2>
      <p class="text-[18px] leading-[28px] mt-4 max-w-[580px] mx-auto" style="color: hsl(219, 10%, 45%);">
        We verzorgen alles zodat je alleen maar hoeft te genieten van je nieuwe huis.
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        'Bouwkundig ontwerp en engineering',
        'Funderingswerk en grondwerk',
        'Complete ruwbouw (muren, vloeren, dak)',
        'Installaties (elektra, water, gas)',
        'Afbouw en afwerking',
        'Interieurdesign en inrichting',
        'Duurzame bouwmaterialen',
        'Energiezuinige systemen',
      ].map(item => (
        <div class="flex items-start gap-3 bg-white p-5 rounded-lg border" style="border-color: hsl(210, 15%, 90%);">
          <svg class="w-5 h-5 mt-0.5 flex-shrink-0" style="color: hsl(211, 62%, 47%);" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-[14px] font-medium" style="color: hsl(220, 19%, 15%);">{item}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Process Section -->
<section class="py-[112px]" style="background-color: hsl(223, 42%, 18%);">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="text-center mb-14">
      <p class="text-[13px] font-semibold tracking-widest uppercase mb-3" style="color: hsl(211, 62%, 47%);">ONZE WERKWIJZE</p>
      <h2 class="text-[42px] font-normal text-white leading-[1.2]">Hoe bouwen we jouw huis?</h2>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        { num: '01', title: 'Visie & Ontwerp', desc: 'We werken samen met jou en bouwkundigen om je visie vorm te geven. Alle details worden in ontwerpen vastgelegd voordat we beginnen.' },
        { num: '02', title: 'Vergunningen', desc: 'We zorgen voor alle nodige vergunningen bij gemeente en instanties. Jij hoeft je geen zorgen te maken.' },
        { num: '03', title: 'Voorbereiding', desc: 'Grondwerk, funderingen en voorbereiding van de bouwplaats. Alles professioneel en veilig.' },
        { num: '04', title: 'Constructie', desc: 'De ruwbouw wordt opgebouwd volgens plan. Regelmatig controle op kwaliteit en veiligheid.' },
        { num: '05', title: 'Installaties', desc: 'Alle technische installaties: elektriciteit, water, verwarming, ventilatie.' },
        { num: '06', title: 'Afbouw', desc: 'Stucwerk, schilderwerk, vloeren, afwerkingen. Alles wat je nieuwe huis af maakt.' },
      ].map(step => (
        <div class="p-6 rounded-lg border" style="background-color: hsl(223, 42%, 23%); border-color: hsl(223, 42%, 28%);">
          <div class="text-[36px] font-bold mb-3" style="color: hsl(211, 62%, 47%);">{step.num}</div>
          <h3 class="text-[18px] font-bold text-white mb-2">{step.title}</h3>
          <p class="text-[14px] leading-[22px]" style="color: rgba(255,255,255,0.6);">{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Why ASP Section -->
<section class="py-[112px] bg-white">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="text-center mb-14">
      <p class="text-[13px] font-semibold tracking-widest uppercase mb-3" style="color: hsl(211, 62%, 47%);">WAAROM KIEZEN VOOR ONS</p>
      <h2 class="text-[42px] font-semibold leading-[1.2]" style="color: hsl(220, 19%, 15%);">Waarom A.S.P voor jouw nieuwbouw?</h2>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {[
        { title: 'Expertise', desc: '25+ jaar ervaring in nieuwbouw, van kleine tot grote projecten' },
        { title: 'Transparantie', desc: 'Geen verrassingen. Duidelijke planning, budgetten en communicatie' },
        { title: 'Duurzaamheid', desc: 'Moderne, energiezuinige systemen en duurzame materialen' },
        { title: 'Kwaliteit', desc: '10-jarige garantie op al het werk. Oog voor detail in elke fase' },
        { title: 'Veiligheid', desc: 'Alle ARBO-maatregelen. Schoon en veilig werkgebied' },
        { title: 'Noord-Holland', desc: 'Lokaal actief, kennis van alle gemeenten en regelgeving' },
      ].map(feat => (
        <div class="p-6 rounded-lg border" style="border-color: hsl(210, 15%, 90%);">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4" style="background-color: hsl(211, 62%, 47%);">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-[18px] font-bold mb-2" style="color: hsl(220, 19%, 15%);">{feat.title}</h3>
          <p class="text-[14px] leading-[22px]" style="color: hsl(219, 10%, 45%);">{feat.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ Section -->
<section class="py-[112px]" style="background: rgba(240, 242, 244, 0.5);">
  <div class="max-w-[800px] mx-auto px-6">
    <div class="text-center mb-12">
      <p class="text-[13px] font-semibold tracking-widest uppercase mb-3" style="color: hsl(211, 62%, 47%);">FAQ</p>
      <h2 class="text-[42px] font-semibold leading-[1.2]" style="color: hsl(220, 19%, 15%);">Veelgestelde Vragen</h2>
      <p class="text-[18px] mt-4" style="color: hsl(219, 10%, 45%);">Alles wat je moet weten over deze dienst.</p>
    </div>
    <div class="space-y-3">
      {[
        {
          q: 'Hoe lang duurt een nieuwbouw project?',
          a: 'Dit hangt af van de grootte en complexiteit. Een standaard woning duurt gemiddeld 8-12 maanden van grondwerk tot oplevering. Dit is inclusief vergunningsprocedures. Wij geven altijd een realistische planning.',
          open: true,
        },
        {
          q: 'Wat gebeurt er met vergunningen?',
          a: 'Wij regelen alle benodigde bouw- en omgevingsvergunningen bij de gemeente. Dit kan 6-12 weken duren. We houden u gedurende het hele proces op de hoogte.',
        },
        {
          q: 'Kunnen we aanpassingen maken tijdens het bouwen?',
          a: 'Kleine aanpassingen zijn mogelijk, maar grote wijzigingen kunnen de planning beïnvloeden. We bespreken alle details vooraf zodat aanpassingen minimaal zijn.',
        },
        {
          q: 'Is duurzaamheid standaard?',
          a: 'Ja, we bouwen standaard energiezuinig met moderne isolatie en installaties. We adviseren ook over zonnepanelen, warmtepompen en andere duurzame opties.',
        },
        {
          q: 'Hoe zit het met waarborging en garantie?',
          a: 'Als BouwGarant gecertificeerd bedrijf bieden we 10 jaar structurele garantie. Dit geeft u zekerheid op de kwaliteit van uw nieuwbouw.',
        },
        {
          q: 'Wat gebeurt er in het intake gesprek?',
          a: 'In het eerste gesprek bespreken we uw wensen, budget en locatie. We geven direct feedback over haalbaarheid en stellen een oriënterende begroting op.',
        },
      ].map((faq) => (
        <details class="group bg-white rounded-lg border overflow-hidden" style="border-color: hsl(210, 15%, 90%);" open={faq.open}>
          <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-[16px] list-none" style="color: hsl(220, 19%, 15%);">
            {faq.q}
            <svg class="w-5 h-5 flex-shrink-0 transition-transform group-open:rotate-180" style="color: hsl(211, 62%, 47%);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-6 pb-6 text-[15px] leading-[24px]" style="color: hsl(219, 10%, 45%);">{faq.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section id="contact" class="py-[112px]" style="background-color: hsl(223, 42%, 18%);">
  <div class="max-w-[1320px] mx-auto px-6 text-center">
    <p class="text-[13px] font-semibold tracking-widest uppercase mb-4" style="color: hsl(211, 62%, 47%);">NEEM CONTACT OP</p>
    <h2 class="text-[42px] font-bold text-white mb-6">Klaar om te bouwen?</h2>
    <p class="text-[18px] leading-[28px] mb-10 max-w-[520px] mx-auto" style="color: rgba(255,255,255,0.7);">
      Neem contact op en laten we jouw droomhuis samen realiseren.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="tel:0641258151"
        class="inline-flex items-center justify-center gap-2 font-bold text-[14px] text-white px-8 py-4 rounded-lg transition-colors"
        style="background-color: hsl(211, 62%, 47%);"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        06 41258151
      </a>
      <a
        href="/#contact"
        class="inline-flex items-center justify-center gap-2 font-bold text-[14px] px-8 py-4 rounded-lg border-2 transition-colors"
        style="border-color: rgba(255,255,255,0.4); color: white;"
      >
        Stuur aanvraag
      </a>
    </div>
  </div>
</section>
