---
---

<!-- Overview Section -->
<section class="py-[112px] bg-white">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-[13px] font-semibold tracking-widest uppercase mb-4" style="color: hsl(211, 62%, 47%);">OVER RENOVATIE</p>
        <h2 class="text-[42px] font-semibold leading-[1.2] mb-6" style="color: hsl(220, 19%, 15%);">Jouw huis vernieuwd</h2>
        <p class="text-[18px] leading-[28px] mb-5" style="color: hsl(219, 10%, 45%);">
          Een oud huis kan weer gloeien. Renovatie gaat niet alleen om het uiterlijk — het gaat om functionaliteit, comfort en duurzaamheid.
        </p>
        <p class="text-[18px] leading-[28px] mb-8" style="color: hsl(219, 10%, 45%);">
          A.S.P heeft tientallen huizen in Noord-Holland getransformeerd. Van badkamer tot complete binnenkant — we kennen de kunst van renoveren.
        </p>
        <ul class="space-y-3">
          {['Kleine tot grote verbouwingen', 'Energiezuinige systemen', 'Moderne materialen', 'Respect voor bestaande structuur'].map(item => (
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 flex-shrink-0" style="color: hsl(142, 76%, 36%);" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-[16px] font-medium" style="color: hsl(220, 19%, 15%);">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <img
          src="https://pagesmith-cdn.com/ba5d94c5/images/acd36fd2c_generated_image-1024.webp"
          alt="Renovatie resultaat"
          class="w-full rounded-lg object-cover"
          style="max-height: 520px;"
        />
      </div>
    </div>
  </div>
</section>

<!-- What We Renovate Section -->
<section class="py-[112px]" style="background: rgba(240, 242, 244, 0.5);">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="text-center mb-14">
      <p class="text-[13px] font-semibold tracking-widest uppercase mb-3" style="color: hsl(211, 62%, 47%);">ONS AANBOD</p>
      <h2 class="text-[42px] font-semibold leading-[1.2]" style="color: hsl(220, 19%, 15%);">Wat kunnen we renoveren?</h2>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        'Badkamer- en toiletrennovatie',
        'Keukenvernieuwing',
        'Vloer- en tegelwerk',
        'Schilderwerk interieur/exterieur',
        'Dakramen en dakwerk',
        'Venster- en deurenvervanging',
        'Isolatie en duurzaamheid',
        'Elektra en installaties modernisering',
      ].map(item => (
        <div class="flex items-start gap-3 bg-white p-5 rounded-lg border" style="border-color: hsl(210, 15%, 90%);">
          <svg class="w-5 h-5 mt-0.5 flex-shrink-0" style="color: hsl(211, 62%, 47%);" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-[14px] font-medium" style="color: hsl(220, 19%, 15%);">{item}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Advantages Section -->
<section class="py-[112px]" style="background-color: hsl(223, 42%, 18%);">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="text-center mb-14">
      <p class="text-[13px] font-semibold tracking-widest uppercase mb-3" style="color: hsl(211, 62%, 47%);">VOORDELEN</p>
      <h2 class="text-[42px] font-normal text-white leading-[1.2]">Voordelen van renovatie</h2>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        { title: 'Waardeverhoging', desc: 'Je huis wordt waardevoller en moderner na de renovatie' },
        { title: 'Efficiëntie', desc: 'Energiezuinige systemen en isolatie besparen geld op de lange termijn' },
        { title: 'Comfort', desc: 'Meer ruimte, beter klimaat en moderne voorzieningen' },
        { title: 'Duurzaamheid', desc: 'Milieuvriendelijke materialen en systemen voor een duurzaam huis' },
        { title: 'Veiligheid', desc: 'Verouderde installaties vervangen door veilige, moderne alternatieven' },
        { title: 'Esthetiek', desc: 'Jouw huis krijgt een frisse, moderne uitstraling die bij je past' },
      ].map(feat => (
        <div class="p-6 rounded-lg border" style="background-color: hsl(223, 42%, 23%); border-color: hsl(223, 42%, 28%);">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4" style="background-color: hsl(211, 62%, 47%);">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-[18px] font-bold text-white mb-2">{feat.title}</h3>
          <p class="text-[14px] leading-[22px]" style="color: rgba(255,255,255,0.6);">{feat.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ Section -->
<section class="py-[112px] bg-white">
  <div class="max-w-[800px] mx-auto px-6">
    <div class="text-center mb-12">
      <p class="text-[13px] font-semibold tracking-widest uppercase mb-3" style="color: hsl(211, 62%, 47%);">FAQ</p>
      <h2 class="text-[42px] font-semibold leading-[1.2]" style="color: hsl(220, 19%, 15%);">Veelgestelde Vragen</h2>
      <p class="text-[18px] mt-4" style="color: hsl(219, 10%, 45%);">Alles wat je moet weten over deze dienst.</p>
    </div>
    <div class="space-y-3">
      {[
        {
          q: 'Kunnen we blijven wonen tijdens renovatie?',
          a: 'Dat hangt af van de schaal. Kleine renovaties kunnen met beperkte overlast worden uitgevoerd. Grote renovaties adviseren we voor te bereiden met mogelijke tijdelijke verhuizing. We bespreken dit samen.',
          open: true,
        },
        {
          q: 'Wat gebeurt er met mijn spullen?',
          a: 'We beschermen uw meubels en spullen met folies en stofzakken. Bij grote renovaties adviseren we om waardevolle spullen tijdelijk op te slaan.',
        },
        {
          q: 'Hoe lang duurt renovatie?',
          a: 'Een badkamerrenovatie duurt 1-2 weken. Een complete woningrenovatie kan 2-4 maanden duren. We geven altijd een realistische planning.',
        },
        {
          q: 'Worden verborgen problemen meegenomen?',
          a: 'Ja, bij het openmaken van muren kunnen verborgen problemen aan het licht komen. We melden dit direct en bespreken oplossingen. Transparantie is ons credo.',
        },
        {
          q: 'Is duurzame renovatie mogelijk?',
          a: 'Absoluut! We adviseren over isolatie, HR++ glas, zonnepanelen en warmtepompen. Duurzame renovatie verlaagt uw energierekening aanzienlijk.',
        },
        {
          q: 'Krijg ik garantie op het werk?',
          a: 'Ja, als BouwGarant-gecertificeerd bedrijf geven we garantie op al ons werk. De garantieperiode is afhankelijk van het type werkzaamheden.',
        },
      ].map((faq) => (
        <details class="group bg-white rounded-lg border overflow-hidden" style="border-color: hsl(210, 15%, 90%);" open={faq.open}>
          <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-[16px] list-none" style="color: hsl(220, 19%, 15%);">
            {faq.q}
            <svg class="w-5 h-5 flex-shrink-0 transition-transform group-open:rotate-180" style="color: hsl(211, 62%, 47%);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-6 pb-6 text-[15px] leading-[24px]" style="color: hsl(219, 10%, 45%);">{faq.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section id="contact" class="py-[112px]" style="background-color: hsl(223, 42%, 18%);">
  <div class="max-w-[1320px] mx-auto px-6 text-center">
    <p class="text-[13px] font-semibold tracking-widest uppercase mb-4" style="color: hsl(211, 62%, 47%);">VRIJBLIJVEND GESPREK</p>
    <h2 class="text-[42px] font-bold text-white mb-6">Renovatieplannen?</h2>
    <p class="text-[18px] leading-[28px] mb-10 max-w-[500px] mx-auto" style="color: rgba(255,255,255,0.7);">
      Laten we het samen uitwerken. Bel ons voor een vrijblijvend gesprek.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="tel:0641258151"
        class="inline-flex items-center justify-center gap-2 font-bold text-[14px] text-white px-8 py-4 rounded-lg"
        style="background-color: hsl(211, 62%, 47%);"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        06 41258151
      </a>
      <a
        href="/#contact"
        class="inline-flex items-center justify-center gap-2 font-bold text-[14px] px-8 py-4 rounded-lg border-2"
        style="border-color: rgba(255,255,255,0.4); color: white;"
      >
        Stuur aanvraag
      </a>
    </div>
  </div>
</section>
