---
const timings = [
  { label: "Kleine verbouwing", duration: "~2-4 weken", pct: 8 },
  { label: "Badkamer renovatie", duration: "~3-5 weken", pct: 12 },
  { label: "Compleet interieur", duration: "~2-3 maanden", pct: 35 },
  { label: "Complete renovatie", duration: "~2-6 maanden", pct: 60 },
  { label: "Nieuwbouw", duration: "~3-12 maanden", pct: 100 },
];
---
<section class="py-[112px]" style="background-color: hsl(0, 0%, 100%);">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="reveal-left">
        <span class="inline-block text-[hsl(211,62%,47%)] text-sm font-semibold uppercase tracking-widest mb-4">Realistische Timing</span>
        <h2 class="text-[42px] font-semibold leading-[1.2] mb-6" style="color: hsl(220, 19%, 15%);">Hoe lang duurt jouw project?</h2>
        <p class="text-[18px] leading-[28px] mb-10" style="color: hsl(219, 10%, 45%);">
          Elk project is uniek. Daarom geven we altijd realistische tijdlijnen gebaseerd op jouw specifieke wensen en het soort werk dat nodig is.
        </p>
        <div class="space-y-5">
          {timings.map((item, i) => (
            <div class={`reveal reveal-delay-${i + 1}`}>
              <div class="flex justify-between mb-1">
                <span class="text-[15px] font-semibold" style="color: hsl(220, 19%, 15%);">{item.label}</span>
                <span class="text-[14px] font-medium" style="color: hsl(211, 62%, 47%);">{item.duration}</span>
              </div>
              <div class="h-2 rounded-full overflow-hidden" style="background-color: hsl(210, 15%, 90%);">
                <div
                  class="h-full rounded-full"
                  style={`width: ${item.pct}%; background-color: hsl(211, 62%, 47%);`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="reveal-right">
        <img
          src="https://pagesmith-cdn.com/ba5d94c5/images/10bcb741f_image-1024.webp"
          alt="Project timeline"
          class="w-full rounded-lg object-cover"
          style="max-height: 520px;"
        />
      </div>
    </div>
  </div>
</section>
