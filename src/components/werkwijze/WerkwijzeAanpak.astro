---
const bullets = [
  "Persoonlijk contact met dezelfde aannemer",
  "Wekelijks updates over de voortgang",
  "Transparante kostenbeheersing",
  "Snelle probleem-oplossing",
  "Respect voor je huis en leven",
  "Schoon en veilig werkgebied",
];
---
<section class="py-[112px]" style="background-color: hsl(223, 42%, 18%);">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="reveal-left">
        <span class="inline-block text-[hsl(211,62%,47%)] text-sm font-semibold uppercase tracking-widest mb-4">Hoe We Werken</span>
        <h2 class="text-[42px] font-semibold text-white leading-[1.2] mb-6">Stap voor Stap Begeleiding</h2>
        <p class="text-[18px] leading-[28px] mb-8" style="color: rgba(255,255,255,0.7);">
          We geloven dat een goed bouwproject begint met goede voorbereiding en duidelijke communicatie. Daarom betrekken we je bij elke stap en zorgen we voor volledige transparantie.
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {bullets.map((bullet) => (
            <li class="flex items-start gap-3">
              <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full flex items-center justify-center" style="background-color: hsl(142, 76%, 36%);">
                <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="text-[15px]" style="color: rgba(255,255,255,0.85);">{bullet}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal-right">
        <img
          src="https://pagesmith-cdn.com/ba5d94c5/images/33b0048eb_generated_image-1024.webp"
          alt="Construction team at work"
          class="w-full rounded-lg object-cover"
          style="max-height: 520px;"
        />
      </div>
    </div>
  </div>
</section>
