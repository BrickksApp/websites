---
export interface Props {
  pagePath?: string;
}
const { pagePath = "" } = Astro.props;

const serviceOptions = [
  "Nieuwbouw", "Ruwbouw", "Renovatie",
  "Aan- & Uitbouw", "Afbouw", "Zakelijk project", "Anders"
];
---
<section id="footer" class="py-[112px]" style="background-color: hsl(0, 0%, 100%);">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

      <!-- Left Column -->
      <div class="reveal-left">
        <span class="inline-block text-[hsl(211,62%,47%)] text-sm font-semibold uppercase tracking-widest mb-4">GRATIS OFFERTE IN 24 UUR</span>
        <h2 class="text-[42px] font-semibold leading-[1.2] mb-6" style="color: hsl(220, 19%, 15%);">
          Laat je huis transformeren — zonder gedoe
        </h2>
        <ul class="space-y-3 mb-10">
          {[
            "Offerte in 24 uur",
            "400+ projecten afgerond",
            "Gratis consulten, geen verplichtingen",
            "Op tijd, binnen budget — altijd"
          ].map((item) => (
            <li class="flex items-center gap-3">
              <span class="flex-shrink-0 w-5 h-5 rounded-full flex items-center justify-center" style="background-color: hsl(142, 76%, 36%);">
                <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="text-[16px]" style="color: hsl(220, 19%, 15%);">{item}</span>
            </li>
          ))}
        </ul>

        <div class="space-y-4">
          <div class="flex items-start gap-4 p-5 rounded-lg border" style="border-color: hsl(210,15%,90%); background-color: hsl(210,15%,98%);">
            <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: hsl(211, 62%, 47%);">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
            </div>
            <div>
              <p class="text-[12px] font-medium uppercase tracking-wider mb-1" style="color: hsl(219,10%,45%);">Heb je haast?</p>
              <a href="tel:0641258151" class="text-[20px] font-bold transition-opacity hover:opacity-70" style="color: hsl(220,19%,15%);">06 41258151</a>
              <p class="text-[13px] mt-1" style="color: hsl(219,10%,45%);">We nemen meteen op</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-5 rounded-lg border" style="border-color: hsl(210,15%,90%); background-color: hsl(210,15%,98%);">
            <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: hsl(211, 62%, 47%);">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <p class="text-[12px] font-medium uppercase tracking-wider mb-1" style="color: hsl(219,10%,45%);">Liever mailen?</p>
              <a href="mailto:info@asp-aannemersbedrijf.nl" class="text-[16px] font-bold transition-opacity hover:opacity-70 break-all" style="color: hsl(220,19%,15%);">info@asp-aannemersbedrijf.nl</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Form -->
      <div class="reveal-right">
        <div class="rounded-lg overflow-hidden border" style="border-color: hsl(210,15%,90%); border-top: 4px solid hsl(211,62%,47%);">
          <div class="p-8" style="background-color: hsl(210,15%,98%);">
            <div class="mb-6">
              <span class="text-[11px] font-bold uppercase tracking-widest" style="color: hsl(211,62%,47%);">SNELLE OFFERTE</span>
              <h3 class="text-[24px] font-bold mt-1" style="color: hsl(220,19%,15%);">Vertel ons alles</h3>
              <p class="text-[14px] mt-1" style="color: hsl(219,10%,45%);">We nemen morgen contact op met jouw plan</p>
            </div>

            <form name="contact" method="POST" data-netlify="true" class="space-y-5">
              <input type="hidden" name="form-name" value="contact" />

              <!-- Service Choice -->
              <div>
                <label class="block text-[13px] font-semibold mb-2" style="color: hsl(220,19%,15%);">Welke dienst heeft u nodig? *</label>
                <div class="flex flex-wrap gap-2">
                  {serviceOptions.map((option) => (
                    <label class="cursor-pointer">
                      <input type="radio" name="dienst" value={option} class="sr-only peer" required />
                      <span class="inline-block px-3 py-1.5 text-[13px] font-medium rounded border transition-colors peer-checked:text-white cursor-pointer" style="border-color: hsl(210,15%,85%); color: hsl(219,10%,45%);"
                        data-service-option>
                        {option}
                      </span>
                    </label>
                  ))}
                </div>
              </div>

              <!-- Name -->
              <div>
                <label class="block text-[13px] font-semibold mb-1.5" style="color: hsl(220,19%,15%);">Naam *</label>
                <input
                  type="text"
                  name="naam"
                  required
                  placeholder="Uw volledige naam"
                  class="w-full px-4 py-3 rounded-lg border text-[14px] outline-none focus:ring-2 transition"
                  style="border-color: hsl(210,15%,85%); background: white; color: hsl(220,19%,15%);"
                />
              </div>

              <!-- Phone -->
              <div>
                <label class="block text-[13px] font-semibold mb-1.5" style="color: hsl(220,19%,15%);">Telefoonnummer *</label>
                <input
                  type="tel"
                  name="telefoon"
                  required
                  placeholder="06 00000000"
                  class="w-full px-4 py-3 rounded-lg border text-[14px] outline-none focus:ring-2 transition"
                  style="border-color: hsl(210,15%,85%); background: white; color: hsl(220,19%,15%);"
                />
              </div>

              <!-- Email -->
              <div>
                <label class="block text-[13px] font-semibold mb-1.5" style="color: hsl(220,19%,15%);">E-mailadres *</label>
                <input
                  type="email"
                  name="email"
                  required
                  placeholder="uw@email.nl"
                  class="w-full px-4 py-3 rounded-lg border text-[14px] outline-none focus:ring-2 transition"
                  style="border-color: hsl(210,15%,85%); background: white; color: hsl(220,19%,15%);"
                />
              </div>

              <!-- Address -->
              <div>
                <label class="block text-[13px] font-semibold mb-1.5" style="color: hsl(220,19%,15%);">Adres van het project *</label>
                <input
                  type="text"
                  name="adres"
                  required
                  placeholder="Straat, huisnummer, stad"
                  class="w-full px-4 py-3 rounded-lg border text-[14px] outline-none focus:ring-2 transition"
                  style="border-color: hsl(210,15%,85%); background: white; color: hsl(220,19%,15%);"
                />
              </div>

              <!-- Start date -->
              <div>
                <label class="block text-[13px] font-semibold mb-1.5" style="color: hsl(220,19%,15%);">Gewenste startdatum *</label>
                <select
                  name="startdatum"
                  required
                  class="w-full px-4 py-3 rounded-lg border text-[14px] outline-none focus:ring-2 transition"
                  style="border-color: hsl(210,15%,85%); background: white; color: hsl(220,19%,15%);"
                >
                  <option value="" disabled selected>Selecteer een optie</option>
                  <option value="zo-snel-mogelijk">Zo snel mogelijk</option>
                  <option value="binnen-1-maand">Binnen 1 maand</option>
                  <option value="binnen-3-maanden">Binnen 3 maanden</option>
                  <option value="flexibel">Flexibel / nog te bepalen</option>
                </select>
              </div>

              <!-- Description -->
              <div>
                <label class="block text-[13px] font-semibold mb-1.5" style="color: hsl(220,19%,15%);">Omschrijving van uw project *</label>
                <textarea
                  name="omschrijving"
                  required
                  rows="4"
                  placeholder="Beschrijf uw project zo uitgebreid mogelijk..."
                  class="w-full px-4 py-3 rounded-lg border text-[14px] outline-none focus:ring-2 transition resize-none"
                  style="border-color: hsl(210,15%,85%); background: white; color: hsl(220,19%,15%);"
                ></textarea>
              </div>

              <!-- Submit -->
              <button
                type="submit"
                class="w-full text-white font-bold rounded-lg px-8 py-4 text-[16px] transition-colors"
                style="background-color: hsl(211, 62%, 47%);"
                onmouseover="this.style.backgroundColor='hsl(211,62%,37%)'"
                onmouseout="this.style.backgroundColor='hsl(211,62%,47%)'"
              >
                Stuur mijn aanvraag gratis →
              </button>

              <div class="flex justify-center gap-6 pt-2">
                {["Offerte morgen", "100% match", "Geen verplichtingen"].map((item) => (
                  <span class="text-[12px] font-medium" style="color: hsl(219,10%,45%);">{item}</span>
                ))}
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  input[type="radio"]:checked + span {
    background-color: hsl(211, 62%, 47%);
    border-color: hsl(211, 62%, 47%);
    color: white;
  }
  input:focus, select:focus, textarea:focus {
    ring-color: hsl(211, 62%, 47%);
    border-color: hsl(211, 62%, 47%);
  }
</style>
