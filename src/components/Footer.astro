---
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const logo = "https://pagesmith-cdn.com/ba5d94c5/images/f62469035_Foto_04-05-2026_om_1545-removebg-preview-640.webp";
---

<footer class="bg-white border-t border-border py-16" data-ps="src/components/Footer.astro:ikmf33">
  <div class="max-w-[1320px] mx-auto px-4 md:px-8" data-ps="src/components/Footer.astro:256hn1">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12" data-ps="src/components/Footer.astro:256hn0">
      <!-- Brand -->
      <div class="col-span-1" data-ps="src/components/Footer.astro:256hmz">
        <a href="/#hero" class="inline-block mb-6" data-ps="src/components/Footer.astro:7gqbxz">
          <img src={logo} alt={SITE.name} class="w-[124px] h-[56px] object-contain" data-ps="src/components/Footer.astro:4nflyi" />
        </a>
        <p class="text-[14px] text-muted-foreground mb-8" data-ps="src/components/Footer.astro:csf9s">
          Meer dan 25 jaar vakmanschap in nieuwbouw en renovatie. Op tijd, binnen budget.
        </p>
        <div class="flex gap-4" data-ps="src/components/Footer.astro:256hmy">
          <a href="#" class="text-foreground hover:text-primary transition-colors" aria-label="Facebook" data-ps="src/components/Footer.astro:7gqby0">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
          </a>
          <a href="#" class="text-foreground hover:text-primary transition-colors" aria-label="Instagram" data-ps="src/components/Footer.astro:7gqby1">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.332 3.608 1.308.975.975 1.245 2.242 1.308 3.608.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.063 1.366-.333 2.633-1.308 3.608-.975.975-2.242 1.245-3.608 1.308-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.063-2.633-.333-3.608-1.308-.975-.975-1.245-2.242-1.308-3.608-.058-1.266-.07-1.646-.07-4.85s.012-3.584.07-4.85c.062-1.366.332-2.633 1.308-3.608.975-.975 2.242-1.245 3.608-1.308 1.266-.058 1.646-.07 4.85-.07zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="#" class="text-foreground hover:text-primary transition-colors" aria-label="Twitter" data-ps="src/components/Footer.astro:7gqby2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" class="text-foreground hover:text-primary transition-colors" aria-label="LinkedIn" data-ps="src/components/Footer.astro:7gqby3">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>

      <!-- Nav Links -->
      <div class="col-span-1" data-ps="src/components/Footer.astro:p4vf82">
        <h2 class="text-[16px] font-bold text-foreground mb-6" data-ps="src/components/Footer.astro:w7klon">Navigatie</h2>
        <ul class="flex flex-col gap-3">
          <li data-ps="src/components/Footer.astro:wyji40"><a href="/" class="text-[14px] text-muted-foreground hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbyn">Home</a></li>
          <li data-ps="src/components/Footer.astro:wyji41"><a href="/Overons" class="text-[14px] text-muted-foreground hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbyo">Over ons</a></li>
          <li data-ps="src/components/Footer.astro:wyji42"><a href="/#diensten" class="text-[14px] text-muted-foreground hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbyp">Diensten</a></li>
          <li data-ps="src/components/Footer.astro:wyji4o"><a href="/Werkwijze" class="text-[14px] text-muted-foreground hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbyq">Werkwijze</a></li>
          <li data-ps="src/components/Footer.astro:wyji4p"><a href="/Werkgebieden" class="text-[14px] text-muted-foreground hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbyr">Werkgebieden</a></li>
        </ul>
      </div>

      <!-- Service Links -->
      <div class="col-span-1" data-ps="src/components/Footer.astro:p4vf83">
        <h2 class="text-[16px] font-bold text-foreground mb-6" data-ps="src/components/Footer.astro:w7kloo">Diensten</h2>
        <ul class="flex flex-col gap-3">
          <li data-ps="src/components/Footer.astro:wyji4q"><a href="/diensten/nieuwbouw" class="text-[14px] text-muted-foreground hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbys">Nieuwbouw</a></li>
          <li data-ps="src/components/Footer.astro:wyji4r"><a href="/diensten/ruwbouw" class="text-[14px] text-muted-foreground hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbyt">Ruwbouw</a></li>
          <li data-ps="src/components/Footer.astro:wyji4s"><a href="/diensten/renovatie" class="text-[14px] text-muted-foreground hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbyu">Renovatie</a></li>
          <li data-ps="src/components/Footer.astro:wyji4t"><a href="/diensten/aan-uitbouw" class="text-[14px] text-muted-foreground hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbyv">Aan- & Uitbouw</a></li>
          <li data-ps="src/components/Footer.astro:wyji4u"><a href="/diensten/afbouw" class="text-[14px] text-muted-foreground hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbyw">Afbouw</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="col-span-1" data-ps="src/components/Footer.astro:p4vf84">
        <h2 class="text-[16px] font-bold text-foreground mb-6" data-ps="src/components/Footer.astro:w7klop">Contact</h2>
        <div class="flex flex-col gap-6" data-ps="src/components/Footer.astro:p4vf85">
          <a href="tel:0641258151" class="flex items-center gap-3 text-[14px] text-muted-foreground hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbzi">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <div data-ps="src/components/Footer.astro:p4vf86">
              <p class="font-bold text-foreground" data-ps="src/components/Footer.astro:csf9t">Telefoon</p>
              <p data-ps="src/components/Footer.astro:csf9u">06 41258151</p>
            </div>
          </a>
          <a href="mailto:info@asp-aannemersbedrijf.nl" class="flex items-center gap-3 text-[14px] text-muted-foreground hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbzj">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <div data-ps="src/components/Footer.astro:p4vf87">
              <p class="font-bold text-foreground" data-ps="src/components/Footer.astro:csf9v">E-mail</p>
              <p data-ps="src/components/Footer.astro:csf9w">info@asp-aannemersbedrijf.nl</p>
            </div>
          </a>
          <div class="flex items-center gap-3 text-[14px] text-muted-foreground" data-ps="src/components/Footer.astro:p4vf88">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <div data-ps="src/components/Footer.astro:p4vf89">
              <p class="font-bold text-foreground" data-ps="src/components/Footer.astro:csf9x">Werkgebied</p>
              <p data-ps="src/components/Footer.astro:csfaj">Noord-Holland & omgeving</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom -->
    <div class="border-t border-border pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-[14px] text-muted-foreground" data-ps="src/components/Footer.astro:p4vf8a">
      <p data-ps="src/components/Footer.astro:csfak">© 2026 A.S.P Aannemersbedrijf. Alle rechten voorbehouden.</p>
      <div class="flex gap-6" data-ps="src/components/Footer.astro:p4vf8b">
        <a href="#" class="hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbzk">Privacybeleid</a>
        <a href="#" class="hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbzl">Gebruiksvoorwaarden</a>
      </div>
    </div>
  </div>
</footer>
