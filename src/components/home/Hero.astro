---
const heroImg = "https://pagesmith-cdn.com/ba5d94c5/images/d5002cb36_Foto04-05-2026om1824-1024.webp";
---

<section id="hero" class="relative min-h-screen flex items-center pt-[200px] pb-[120px] overflow-hidden" data-ps="src/components/home/Hero.astro:g4bd0a">
  <!-- Background Image & Overlay -->
  <div class="absolute inset-0 z-0" data-ps="src/components/home/Hero.astro:iy4taf">
    <img src={heroImg} alt="Bouwplaats" class="w-full h-full object-cover" loading="eager" fetchpriority="high" data-ps="src/components/home/Hero.astro:gfvoyy" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/40 to-black/10" data-ps="src/components/home/Hero.astro:iy4tag"></div>
  </div>

  <div class="max-w-[1320px] mx-auto px-4 md:px-8 relative z-10" data-ps="src/components/home/Hero.astro:iy4tah">
    <div class="max-w-[800px]" data-ps="src/components/home/Hero.astro:ecxgf3">
      <div class="inline-flex items-center px-4 py-1 rounded-full border-2 border-white/20 text-white text-[14px] font-medium mb-8 hero-animate" data-ps="src/components/home/Hero.astro:ecxgf4">
        Diensten
      </div>
      
      <h1 class="text-[48px] md:text-[72px] font-bold text-white leading-[1.1] tracking-tight mb-6 hero-animate hero-animate-delay-1" data-ps="src/components/home/Hero.astro:307k1p">
        Nieuwbouw & renovatie met <span class="text-primary" data-ps="src/components/home/Hero.astro:z1i1wm">zekerheid</span>
      </h1>
      
      <p class="text-[18px] leading-[28px] text-white/70 mb-10 max-w-[600px] hero-animate hero-animate-delay-2" data-ps="src/components/home/Hero.astro:6uykn2">
        Schilderwerk, verbouwing, nieuwbouw & meer – zakelijk of particulier. Groot of klein, wij regelen het. Op tijd, binnen budget.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 mb-12 hero-animate hero-animate-delay-3" data-ps="src/components/home/Hero.astro:ecxgf5">
        <a href="tel:0641258151" class="px-8 py-4 bg-primary text-white text-[14px] font-bold rounded-lg hover:bg-primary-hover transition-colors text-center shadow-lg shadow-primary/20" data-ps="src/components/home/Hero.astro:8zc2o">
          Bel Ons: 06 41258151
        </a>
        <a href="/#contact" class="px-8 py-4 bg-secondary text-white text-[14px] font-bold rounded-lg hover:bg-secondary-hover transition-colors text-center shadow-lg shadow-secondary/20" data-ps="src/components/home/Hero.astro:8zc2p">
          Doe je aanvraag
        </a>
      </div>

      <div class="flex flex-col gap-6 hero-animate hero-animate-delay-4" data-ps="src/components/home/Hero.astro:ecxgf6">
        <div class="flex items-center gap-3" data-ps="src/components/home/Hero.astro:ecxgf7">
          <div class="flex gap-1" data-ps="src/components/home/Hero.astro:ecxgf8">
            {[1,2,3,4,5].map(() => (
              <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <span class="text-white font-medium text-[14px]" data-ps="src/components/home/Hero.astro:z1i1wl">5.0/5 · Google Reviews</span>
        </div>

        <div class="flex flex-wrap gap-8" data-ps="src/components/home/Hero.astro:ecxgf9">
          <div class="flex items-center gap-2 text-white/80 text-[14px]" data-ps="src/components/home/Hero.astro:ecxgfa">
            <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            400+ Projecten
          </div>
          <div class="flex items-center gap-2 text-white/80 text-[14px]" data-ps="src/components/home/Hero.astro:ecxgfb">
            <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            100% Tevredenheid
          </div>
          <div class="flex items-center gap-2 text-white/80 text-[14px]" data-ps="src/components/home/Hero.astro:ecxgfc">
            <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            25 Jaar Ervaring
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
