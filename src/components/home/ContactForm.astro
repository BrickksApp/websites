---
---

<section id="contact" class="bg-white py-[112px]" data-ps="src/components/home/ContactForm.astro:mno123">
  <div class="max-w-[1320px] mx-auto px-4 md:px-8" data-ps="src/components/home/ContactForm.astro:fufmag">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16" data-ps="src/components/home/ContactForm.astro:fufmaf">
      <!-- Content -->
      <div class="reveal" data-ps="src/components/home/ContactForm.astro:fufmae">
        <span class="text-primary text-[14px] font-bold tracking-[2px] uppercase block mb-4" data-ps="src/components/home/ContactForm.astro:g2vc0w">Gratis Offerte in 24 Uur</span>
        <h2 class="text-[42px] font-semibold text-foreground leading-[1.2] mb-8" data-ps="src/components/home/ContactForm.astro:f1qe67">Laat je huis transformeren — zonder gedoe</h2>
        <p class="text-[16px] leading-[28px] text-muted-foreground mb-10" data-ps="src/components/home/ContactForm.astro:p5uxva">
          Vul snel je project in. Wij bellen <strong>morgen</strong> al terug met een exact plan en offerte. Gratis. Vrijblijvend.
        </p>

        <div class="space-y-6 mb-12" data-ps="src/components/home/ContactForm.astro:fufmad">
          <div class="flex items-center gap-4 text-foreground font-medium" data-ps="src/components/home/ContactForm.astro:fufmac">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Offerte in 24 uur
          </div>
          <div class="flex items-center gap-4 text-foreground font-medium" data-ps="src/components/home/ContactForm.astro:fufmab">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            400+ projecten afgerond
          </div>
          <div class="flex items-center gap-4 text-foreground font-medium" data-ps="src/components/home/ContactForm.astro:fufmaa">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Gratis consulten, geen verplichtingen
          </div>
          <div class="flex items-center gap-4 text-foreground font-medium" data-ps="src/components/home/ContactForm.astro:fufma9">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Op tijd, binnen budget — altijd
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 pt-10 border-t border-border" data-ps="src/components/home/ContactForm.astro:fufma8">
          <div data-ps="src/components/home/ContactForm.astro:fufm9m">
            <p class="text-[14px] text-muted-foreground mb-2" data-ps="src/components/home/ContactForm.astro:p5uxv9">Heb je haast?</p>
            <a href="tel:0641258151" class="text-[20px] font-bold text-foreground hover:text-primary transition-colors block mb-1" data-ps="src/components/home/ContactForm.astro:i1x167">06 41258151</a>
            <p class="text-[14px] text-secondary font-medium italic" data-ps="src/components/home/ContactForm.astro:p5uxv8">We nemen meteen op</p>
          </div>
          <div data-ps="src/components/home/ContactForm.astro:fufm9l">
            <p class="text-[14px] text-muted-foreground mb-2" data-ps="src/components/home/ContactForm.astro:p5uxv7">Liever mailen?</p>
            <a href="mailto:info@asp-aannemersbedrijf.nl" class="text-[16px] font-bold text-foreground hover:text-primary transition-colors break-words" data-ps="src/components/home/ContactForm.astro:i1x166">info@asp-aannemersbedrijf.nl</a>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="reveal reveal-delay-1" data-ps="src/components/home/ContactForm.astro:fufm9k">
        <div class="bg-surface rounded-lg border border-border overflow-hidden shadow-2xl relative" data-ps="src/components/home/ContactForm.astro:fufm9j">
          <div class="h-2 bg-primary" data-ps="src/components/home/ContactForm.astro:fufm9i"></div>
          <div class="p-8" data-ps="src/components/home/ContactForm.astro:fufm9h">
            <div class="flex items-center gap-3 mb-6" data-ps="src/components/home/ContactForm.astro:fufm9g">
              <span class="px-3 py-1 bg-primary/10 text-primary text-[12px] font-bold rounded uppercase tracking-wider" data-ps="src/components/home/ContactForm.astro:g2vc0v">Snelle Offerte</span>
            </div>
            <h3 class="text-[24px] font-bold text-foreground mb-2" data-ps="src/components/home/ContactForm.astro:dbgy1">Vertel ons alles</h3>
            <p class="text-[14px] text-muted-foreground mb-8" data-ps="src/components/home/ContactForm.astro:p5uxv6">We nemen morgen contact op met jouw plan</p>

            <form id="contact-form" class="space-y-6">
              <div data-ps="src/components/home/ContactForm.astro:fufm9f">
                <label class="block text-[14px] font-bold text-foreground mb-4" data-ps="src/components/home/ContactForm.astro:5gyysn">Welke dienst heeft u nodig? *</label>
                <div class="flex flex-wrap gap-2" data-ps="src/components/home/ContactForm.astro:fufm9e">
                  {['Nieuwbouw', 'Ruwbouw', 'Renovatie', 'Aan- & Uitbouw', 'Afbouw', 'Schilderwerk', 'Zakelijk project', 'Anders'].map((service, __psIdx) => (
                    <label class="cursor-pointer group" data-ps={`src/components/home/ContactForm.astro:5gyys1-${__psIdx}`}>
                      <input type="radio" name="dienst" value={service} class="peer hidden" required />
                      <span class="px-4 py-2 border border-border bg-white text-[13px] font-medium rounded-full peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all group-hover:border-primary block" data-ps={`src/components/home/ContactForm.astro:g2vc0u-${__psIdx}`}>
                        {service}
                      </span>
                    </label>
                  ))}
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/ContactForm.astro:fufm9d">
                <div data-ps="src/components/home/ContactForm.astro:9ocn1j">
                  <label for="name" class="block text-[12px] font-bold text-foreground uppercase tracking-wider mb-2" data-ps="src/components/home/ContactForm.astro:5gyys0">Naam *</label>
                  <input type="text" id="name" name="name" required class="w-full px-4 py-3 bg-white border border-border rounded focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" placeholder="John Doe" />
                </div>
                <div data-ps="src/components/home/ContactForm.astro:9ocn1i">
                  <label for="phone" class="block text-[12px] font-bold text-foreground uppercase tracking-wider mb-2" data-ps="src/components/home/ContactForm.astro:5gyyrz">Telefoonnummer *</label>
                  <input type="tel" id="phone" name="phone" required class="w-full px-4 py-3 bg-white border border-border rounded focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" placeholder="06 41258151" />
                </div>
              </div>

              <div data-ps="src/components/home/ContactForm.astro:9ocn1h">
                <label for="email" class="block text-[12px] font-bold text-foreground uppercase tracking-wider mb-2" data-ps="src/components/home/ContactForm.astro:5gyyry">E-mailadres *</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-3 bg-white border border-border rounded focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" placeholder="john@example.nl" />
              </div>

              <div data-ps="src/components/home/ContactForm.astro:9ocn1g">
                <label for="address" class="block text-[12px] font-bold text-foreground uppercase tracking-wider mb-2" data-ps="src/components/home/ContactForm.astro:5gyyrx">Adres van het project *</label>
                <input type="text" id="address" name="address" required class="w-full px-4 py-3 bg-white border border-border rounded focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" placeholder="Straatnaam, Amsterdam" />
              </div>

              <div data-ps="src/components/home/ContactForm.astro:9ocn1f">
                <label for="startdate" class="block text-[12px] font-bold text-foreground uppercase tracking-wider mb-2" data-ps="src/components/home/ContactForm.astro:5gyyrw">Gewenste startdatum *</label>
                <select id="startdate" name="startdate" required class="w-full px-4 py-3 bg-white border border-border rounded focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none appearance-none cursor-pointer">
                  <option value="">Selecteer een optie</option>
                  <option value="zo-snel-mogelijk">Zo snel mogelijk</option>
                  <option value="binnen-1-maand">Binnen 1 maand</option>
                  <option value="binnen-3-maanden">Binnen 3 maanden</option>
                  <option value="flexibel">Flexibel / nog te bepalen</option>
                </select>
              </div>

              <div data-ps="src/components/home/ContactForm.astro:9ocn1e">
                <label for="description" class="block text-[12px] font-bold text-foreground uppercase tracking-wider mb-2" data-ps="src/components/home/ContactForm.astro:5gyyrv">Omschrijving van uw project *</label>
                <textarea id="description" name="description" required rows="4" class="w-full px-4 py-3 bg-white border border-border rounded focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none resize-none" placeholder="Vertel ons wat u wilt laten bouwen..."></textarea>
              </div>

              <button type="submit" class="w-full py-5 bg-primary text-white text-[16px] font-bold rounded-lg hover:bg-primary-hover transition-all flex items-center justify-center gap-2 shadow-xl shadow-primary/20" data-ps="src/components/home/ContactForm.astro:n0ol88">
                Stuur mijn aanvraag gratis <span data-ps="src/components/home/ContactForm.astro:g2vc0t">→</span>
              </button>

              <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 pt-4 border-t border-border/50 text-[12px] text-muted-foreground" data-ps="src/components/home/ContactForm.astro:9ocn1d">
                <div class="flex items-center gap-1" data-ps="src/components/home/ContactForm.astro:9ocn1c">
                  <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Offerte morgen
                </div>
                <div class="flex items-center gap-1" data-ps="src/components/home/ContactForm.astro:9ocn1b">
                  <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  100% match
                </div>
                <div class="flex items-center gap-1" data-ps="src/components/home/ContactForm.astro:9ocn1a">
                  <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Geen verplichtingen
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    try {
      const response = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      
      if (response.ok) {
        alert('Bedankt! Uw aanvraag is verzonden. We nemen morgen contact met u op.');
        form.reset();
      } else {
        alert('Er is iets misgegaan. Probeer het later opnieuw.');
      }
    } catch (err) {
      alert('Er is iets misgegaan. Probeer het later opnieuw.');
    }
  });
</script>
