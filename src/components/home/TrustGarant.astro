---
const garantLogo = "https://pagesmith-cdn.com/ba5d94c5/images/b979c12ac_image-1024.webp";
---

<section id="bouwgarant" class="bg-white py-[112px]" data-ps="src/components/home/TrustGarant.astro:def456">
  <div class="max-w-[1320px] mx-auto px-4 md:px-8" data-ps="src/components/home/TrustGarant.astro:meuis0">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start" data-ps="src/components/home/TrustGarant.astro:meuis1">
      <div class="reveal" data-ps="src/components/home/TrustGarant.astro:meuis2">
        <span class="text-primary text-[14px] font-bold tracking-[2px] uppercase block mb-4" data-ps="src/components/home/TrustGarant.astro:qplh9l">Erkend & Gecertificeerd</span>
        <h2 class="text-[42px] font-semibold text-foreground leading-tight mb-8" data-ps="src/components/home/TrustGarant.astro:19kw86">
          U bouwt met de <span class="text-primary" data-ps="src/components/home/TrustGarant.astro:qplh9m">zekerheid van BouwGarant</span>
        </h2>
        <p class="text-[16px] leading-relaxed text-muted-foreground mb-10" data-ps="src/components/home/TrustGarant.astro:bmowi">
          A.S.P Aannemersbedrijf is aangesloten bij <strong>BouwGarant</strong> -- hét keurmerk voor betrouwbare bouwbedrijven in Nederland. Dit betekent dat u niet alleen vertrouwt op onze 25+ jaar ervaring, maar ook op onafhankelijke borging van uw bouwproject.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6 mb-12" data-ps="src/components/home/TrustGarant.astro:meuis3">
          <div class="flex items-start gap-3" data-ps="src/components/home/TrustGarant.astro:meuisp">
            <svg class="w-6 h-6 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <div data-ps="src/components/home/TrustGarant.astro:meuisq">
              <p class="font-bold text-foreground" data-ps="src/components/home/TrustGarant.astro:bmowj">Gecertificeerd vakbedrijf</p>
              <p class="text-[14px] text-muted-foreground" data-ps="src/components/home/TrustGarant.astro:bmox5">Strenge kwaliteitsnormen geborgd.</p>
            </div>
          </div>
          <div class="flex items-start gap-3" data-ps="src/components/home/TrustGarant.astro:meuisr">
            <svg class="w-6 h-6 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <div data-ps="src/components/home/TrustGarant.astro:meuiss">
              <p class="font-bold text-foreground" data-ps="src/components/home/TrustGarant.astro:bmox6">Onafhankelijke garantie</p>
              <p class="text-[14px] text-muted-foreground" data-ps="src/components/home/TrustGarant.astro:bmox7">Altijd beschermd bij onvoorziene zaken.</p>
            </div>
          </div>
          <div class="flex items-start gap-3" data-ps="src/components/home/TrustGarant.astro:meuist">
            <svg class="w-6 h-6 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <div data-ps="src/components/home/TrustGarant.astro:meuisu">
              <p class="font-bold text-foreground" data-ps="src/components/home/TrustGarant.astro:bmox8">10 jaar structurele garantie</p>
              <p class="text-[14px] text-muted-foreground" data-ps="src/components/home/TrustGarant.astro:bmox9">Bouwkundige zekerheid voor de lange termijn.</p>
            </div>
          </div>
          <div class="flex items-start gap-3" data-ps="src/components/home/TrustGarant.astro:meuisv">
            <svg class="w-6 h-6 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <div data-ps="src/components/home/TrustGarant.astro:meuisw">
              <p class="font-bold text-foreground" data-ps="src/components/home/TrustGarant.astro:bmoxa">Vertrouwen van duizenden</p>
              <p class="text-[14px] text-muted-foreground" data-ps="src/components/home/TrustGarant.astro:bmoxb">Kwaliteit, eerlijkheid en betrouwbaarheid.</p>
            </div>
          </div>
        </div>

        <a href="/#contact" class="inline-block px-8 py-4 bg-primary text-white text-[14px] font-bold rounded-lg hover:bg-primary-hover transition-colors shadow-lg shadow-primary/20" data-ps="src/components/home/TrustGarant.astro:7fklm8">
          Vraag een gratis offerte aan
        </a>
      </div>

      <div class="reveal reveal-delay-1" data-ps="src/components/home/TrustGarant.astro:meuisx">
        <div class="bg-white rounded-lg border border-border shadow-xl p-8 max-w-[500px] mx-auto lg:mr-0" data-ps="src/components/home/TrustGarant.astro:meuisy">
          <div class="flex justify-center mb-8" data-ps="src/components/home/TrustGarant.astro:aqerl6">
            <img src={garantLogo} alt="BouwGarant Logo" class="h-20 object-contain" data-ps="src/components/home/TrustGarant.astro:jwlegj" />
          </div>
          
          <div class="flex justify-between items-center py-6 border-y border-border mb-8 text-center" data-ps="src/components/home/TrustGarant.astro:aqerl5">
            <div class="px-2" data-ps="src/components/home/TrustGarant.astro:aqerl4">
              <p class="text-[24px] font-bold text-foreground" data-ps="src/components/home/TrustGarant.astro:bmoxc">25+</p>
              <p class="text-[12px] text-muted-foreground uppercase font-bold tracking-wider" data-ps="src/components/home/TrustGarant.astro:bmoxd">Jaar ervaring</p>
            </div>
            <div class="w-px h-12 bg-border" data-ps="src/components/home/TrustGarant.astro:aqerl3"></div>
            <div class="px-2" data-ps="src/components/home/TrustGarant.astro:aqerl2">
              <p class="text-[24px] font-bold text-foreground" data-ps="src/components/home/TrustGarant.astro:bmoxe">400+</p>
              <p class="text-[12px] text-muted-foreground uppercase font-bold tracking-wider" data-ps="src/components/home/TrustGarant.astro:bmoy0">Projecten</p>
            </div>
            <div class="w-px h-12 bg-border" data-ps="src/components/home/TrustGarant.astro:aqerl1"></div>
            <div class="px-2" data-ps="src/components/home/TrustGarant.astro:aqerl0">
              <p class="text-[24px] font-bold text-foreground" data-ps="src/components/home/TrustGarant.astro:bmoy1">10j</p>
              <p class="text-[12px] text-muted-foreground uppercase font-bold tracking-wider" data-ps="src/components/home/TrustGarant.astro:bmoy2">Garantie</p>
            </div>
          </div>

          <div class="bg-dark rounded-lg p-6 relative" data-ps="src/components/home/TrustGarant.astro:aqerkz">
            <svg class="absolute top-4 left-4 w-8 h-8 text-white/10 fill-current" viewBox="0 0 24 24"><path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C14.9124 8 14.017 8.89543 14.017 10V13M6.017 21L6.017 18C6.017 16.8954 6.91243 16 8.017 16H11.017C11.5693 16 12.017 15.5523 12.017 15V9C12.017 8.44772 11.5693 8 11.017 8H8.017C6.91243 8 6.017 8.89543 6.017 10V13"/></svg>
            <p class="text-white text-[15px] italic leading-relaxed mb-4 relative z-10" data-ps="src/components/home/TrustGarant.astro:bmoy3">
              "BouwGarant geeft mij als klant de zekerheid dat alles goed geregeld is -- ook als er iets onverwachts gebeurt."
            </p>
            <div class="flex items-center gap-2" data-ps="src/components/home/TrustGarant.astro:aqerky">
              <div class="flex gap-0.5" data-ps="src/components/home/TrustGarant.astro:aqerkx">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-4 h-4 text-yellow-400 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <span class="text-white/60 text-[12px]" data-ps="src/components/home/TrustGarant.astro:qplh9n">Gemiddelde beoordeling</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
