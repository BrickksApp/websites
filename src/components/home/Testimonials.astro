---
const reviewLogo = "https://pagesmith-cdn.com/ba5d94c5/images/cbcc2dc18_Foto_04-05-2026_om_1817-removebg-preview-768.webp";
---

<section id="beoordelingen" class="bg-surface/30 py-[112px]" data-ps="src/components/home/Testimonials.astro:jkl123">
  <div class="max-w-[1320px] mx-auto px-4 md:px-8" data-ps="src/components/home/Testimonials.astro:rl25kt">
    <div class="text-center mb-16" data-ps="src/components/home/Testimonials.astro:rl25ku">
      <div class="flex justify-center mb-6" data-ps="src/components/home/Testimonials.astro:rl25kv">
        <img src={reviewLogo} alt="Klantenoordelen.nl Logo" class="h-16 object-contain" data-ps="src/components/home/Testimonials.astro:p2t19c" />
      </div>
      <h2 class="text-[36px] font-bold text-foreground mb-4" data-ps="src/components/home/Testimonials.astro:o88cj1">Wat onze klanten zeggen</h2>
      <p class="text-[18px] text-muted-foreground" data-ps="src/components/home/Testimonials.astro:wtgria">Echte beoordelingen van tevreden klanten</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16" data-ps="src/components/home/Testimonials.astro:rl25kw">
      <!-- Alex -->
      <div class="bg-white p-8 rounded-lg border border-border flex flex-col justify-between reveal" data-ps="src/components/home/Testimonials.astro:rl25kx">
        <div data-ps="src/components/home/Testimonials.astro:rl25ky">
          <div class="flex gap-1 mb-4" data-ps="src/components/home/Testimonials.astro:rl25kz">
          {[1,2,3,4,5].map(() => (
          <svg class="w-5 h-5 text-yellow-700 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
          </div>
          <h3 class="text-[16px] font-bold text-foreground mb-3" data-ps="src/components/home/Testimonials.astro:w4gs7v">Top bedrijf</h3>
          <p class="text-[15px] leading-relaxed text-muted-foreground italic mb-6" data-ps="src/components/home/Testimonials.astro:wtgrib">
            Dankjewel voor het werk wat jullie hebben geleverd mannen
          </p>
        </div>
        <div class="text-[14px]" data-ps="src/components/home/Testimonials.astro:jqcpy3">
          <p class="font-bold text-foreground" data-ps="src/components/home/Testimonials.astro:wtgrix">Alex</p>
          <p class="text-muted-foreground" data-ps="src/components/home/Testimonials.astro:wtgriy">ma 01 dec 2025</p>
        </div>
      </div>

      <!-- Edwin Berk -->
      <div class="bg-white p-8 rounded-lg border border-border flex flex-col justify-between reveal reveal-delay-1" data-ps="src/components/home/Testimonials.astro:jqcpy2">
        <div data-ps="src/components/home/Testimonials.astro:jqcpy1">
          <div class="flex gap-1 mb-4" data-ps="src/components/home/Testimonials.astro:jqcpy0">
          {[1,2,3,4,5].map(() => (
          <svg class="w-5 h-5 text-yellow-700 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
          </div>
          <h3 class="text-[16px] font-bold text-foreground mb-3" data-ps="src/components/home/Testimonials.astro:w4gs7w">Super tevreden vakkundig en vakwerk afgeleverd!</h3>
          <p class="text-[15px] leading-relaxed text-muted-foreground italic mb-6" data-ps="src/components/home/Testimonials.astro:wtgriz">
            Uitstekend bouwbedrijf! Vanaf het eerste contact tot aan de oplevering is alles perfect verlopen. Ze werken nauwkeurig, communiceren duidelijk en houden zich keurig aan afspraken. Het vakmanschap is indrukwekkend en de kwaliteit van het werk is zichtbaar tot in de kleinste details.
          </p>
        </div>
        <div class="text-[14px]" data-ps="src/components/home/Testimonials.astro:jqcpxz">
          <p class="font-bold text-foreground" data-ps="src/components/home/Testimonials.astro:wtgrj0">Edwin Berk</p>
          <p class="text-muted-foreground" data-ps="src/components/home/Testimonials.astro:wtgrj1">ma 01 dec 2025</p>
        </div>
      </div>

      <!-- Dylan -->
      <div class="bg-white p-8 rounded-lg border border-border flex flex-col justify-between reveal reveal-delay-2" data-ps="src/components/home/Testimonials.astro:jqcpxy">
        <div data-ps="src/components/home/Testimonials.astro:jqcpxx">
          <div class="flex gap-1 mb-4" data-ps="src/components/home/Testimonials.astro:jqcpxw">
            {[1,2,3,4,5].map(() => (
              <svg class="w-5 h-5 text-yellow-700 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <h3 class="text-[16px] font-bold text-foreground mb-3" data-ps="src/components/home/Testimonials.astro:w4gs8i">Zeer tevreden over deze aannemer!</h3>
          <p class="text-[15px] leading-relaxed text-muted-foreground italic mb-6" data-ps="src/components/home/Testimonials.astro:wtgrj2">
            Ik ben ontzettend blij met het werk dat zij hebben verricht bij de verbouwing van mijn huis. De aanbouw is tot in de puntjes afgewerkt en de tuin hebben ze prachtig aangepakt. Alles is netjes, volgens planning en met oog voor detail uitgevoerd.
          </p>
        </div>
        <div class="text-[14px]" data-ps="src/components/home/Testimonials.astro:jqcpxv">
          <p class="font-bold text-foreground" data-ps="src/components/home/Testimonials.astro:wtgrj3">Dylan</p>
          <p class="text-muted-foreground" data-ps="src/components/home/Testimonials.astro:wtgrj4">za 01 nov 2025</p>
        </div>
      </div>

      <!-- Marco -->
      <div class="bg-white p-8 rounded-lg border border-border flex flex-col justify-between reveal reveal-delay-1" data-ps="src/components/home/Testimonials.astro:jqcpxt">
        <div data-ps="src/components/home/Testimonials.astro:jqcpxs">
          <div class="flex gap-1 mb-4" data-ps="src/components/home/Testimonials.astro:jqcpxr">
            {[1,2,3,4,5].map(() => (
              <svg class="w-5 h-5 text-yellow-700 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <h3 class="text-[16px] font-bold text-foreground mb-3" data-ps="src/components/home/Testimonials.astro:w4gs8j">Top en vlot gedaan</h3>
          <p class="text-[15px] leading-relaxed text-muted-foreground italic mb-6" data-ps="src/components/home/Testimonials.astro:wtgrj5">
            Ik ben zeer tevreden over het werk dat ASP Timmerwerken heeft geleverd bij het plaatsen van mijn dakkapel. Vanaf het eerste contact tot aan de oplevering is alles vlot en professioneel verlopen. De communicatie was duidelijk, de afspraken werden netjes nagekomen en het eindresultaat is van uitstekende kwaliteit.
          </p>
        </div>
        <div class="text-[14px]" data-ps="src/components/home/Testimonials.astro:jqcpxq">
          <p class="font-bold text-foreground" data-ps="src/components/home/Testimonials.astro:wtgrj6">Marco</p>
          <p class="text-muted-foreground" data-ps="src/components/home/Testimonials.astro:wtgrj7">za 01 nov 2025</p>
        </div>
      </div>

      <!-- Ryan -->
      <div class="bg-white p-8 rounded-lg border border-border flex flex-col justify-between reveal reveal-delay-2" data-ps="src/components/home/Testimonials.astro:jqcpxp">
        <div data-ps="src/components/home/Testimonials.astro:jqcpxo">
          <div class="flex gap-1 mb-4" data-ps="src/components/home/Testimonials.astro:jqcpxn">
            {[1,2,3,4,5].map(() => (
              <svg class="w-5 h-5 text-yellow-700 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <h3 class="text-[16px] font-bold text-foreground mb-3" data-ps="src/components/home/Testimonials.astro:w4gs8k">Vakkundig bedrijf.</h3>
          <p class="text-[15px] leading-relaxed text-muted-foreground italic mb-6" data-ps="src/components/home/Testimonials.astro:wtgrj8">
            Paar keer al bij mij langs laten komen voor wat renovaties en laatst voor een uitbouw en het ziet er top uit. Vriendelijk personeel en gewoon simpel en duidelijk snel een offerte, geen poespas eromheen. Simpel en snel. zo hoort het.
          </p>
        </div>
        <div class="text-[14px]" data-ps="src/components/home/Testimonials.astro:jqcpxm">
          <p class="font-bold text-foreground" data-ps="src/components/home/Testimonials.astro:wtgrj9">Ryan</p>
          <p class="text-muted-foreground" data-ps="src/components/home/Testimonials.astro:wtgrja">za 01 nov 2025</p>
        </div>
      </div>
    </div>

    <div class="text-center" data-ps="src/components/home/Testimonials.astro:jqcpxu">
      <a href="https://klantenoordelen.nl/beoordelingen/timmerbedrijf-pantic" target="_blank" class="inline-block px-6 py-3 border border-primary text-primary text-[14px] font-semibold rounded-lg hover:bg-primary hover:text-white transition-all duration-300" data-ps="src/components/home/Testimonials.astro:v3pdr1">
        Alle beoordelingen bekijken →
      </a>
    </div>
  </div>
</section>
