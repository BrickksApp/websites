---
const values = [
  {
    title: "Vakmanschap",
    description: "Elk nagel, elk voegje, elk stukje timmerhout — alles wordt uitgevoerd met de laagste standaard van perfectie.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" /></svg>`,
  },
  {
    title: "Ontzorging",
    description: "Jij zit niet te wachten op gedoe. Wij regelen vergunningen, planning, materialen — alles. Jij hoort alleen goed nieuws.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
  },
  {
    title: "Betrouwbaarheid",
    description: "Op tijd, binnen budget, naar afspraak. Dit is niet negotiabel voor ons — dit is wat je mag verwachten.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
  {
    title: "Passie",
    description: "Onze team bestaat uit mannen en vrouwen die echt van bouwen houden. Dit zie je in elk project.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>`,
  },
];
---
<section class="py-[112px]" style="background: rgba(240, 242, 244, 0.5);">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="text-center mb-12 reveal">
      <span class="inline-block text-[hsl(211,62%,47%)] text-sm font-semibold uppercase tracking-widest mb-3">Waar We Voor Staan</span>
      <h2 class="text-[42px] font-semibold" style="color: hsl(220, 19%, 15%);">Onze Core Values</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {values.map((value, i) => (
        <div class={`bg-white rounded-lg p-8 border border-[hsl(210,15%,90%)] hover:shadow-md transition-shadow reveal reveal-delay-${i + 1}`}>
          <div class="w-12 h-12 rounded-full flex items-center justify-center mb-4" style="background-color: hsl(211, 62%, 47%); color: white;">
            <Fragment set:html={value.icon} />
          </div>
          <h3 class="text-[18px] font-bold mb-3" style="color: hsl(220, 19%, 15%);">{value.title}</h3>
          <p class="text-[14px] leading-[22.75px]" style="color: hsl(219, 10%, 45%);">{value.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
