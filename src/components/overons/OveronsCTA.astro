<section class="py-[112px]" style="background-color: hsl(223, 42%, 18%);">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="max-w-[700px] mx-auto text-center reveal">
      <h2 class="text-[42px] font-semibold text-white mb-4">Klaar om te starten?</h2>
      <p class="text-[18px] leading-[28px] mb-8" style="color: rgba(255,255,255,0.7);">
        Neem vandaag nog contact met ons op. Geen verplichtingen, geen gedoe. Gewoon een eerlijk gesprek over jouw project.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a
          href="tel:0641258151"
          class="inline-flex items-center justify-center gap-2 text-white font-bold rounded-lg px-8 py-4 text-[16px] transition-colors"
          style="background-color: hsl(211, 62%, 47%);"
          onmouseover="this.style.backgroundColor='hsl(211,62%,37%)'"
          onmouseout="this.style.backgroundColor='hsl(211,62%,47%)'"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          Bel: 06 41258151
        </a>
        <a
          href="/Overons/#footer"
          class="inline-flex items-center justify-center gap-2 font-bold rounded-lg px-8 py-4 text-[16px] border-2 transition-colors"
          style="border-color: rgba(255,255,255,0.5); color: white;"
          onmouseover="this.style.backgroundColor='rgba(255,255,255,0.1)'"
          onmouseout="this.style.backgroundColor='transparent'"
        >
          Stuur een aanvraag
        </a>
      </div>
      <div class="flex flex-col sm:flex-row justify-center gap-8 pt-8" style="border-top: 1px solid rgba(255,255,255,0.15);">
        <div class="text-center">
          <div class="text-[14px] font-medium mb-1" style="color: rgba(255,255,255,0.5);">Telefoon</div>
          <a href="tel:0641258151" class="text-[16px] font-semibold text-white hover:opacity-80 transition-opacity">06 41258151</a>
        </div>
        <div class="text-center">
          <div class="text-[14px] font-medium mb-1" style="color: rgba(255,255,255,0.5);">E-mail</div>
          <a href="mailto:info@asp-aannemersbedrijf.nl" class="text-[16px] font-semibold text-white hover:opacity-80 transition-opacity">info@asp-aannemersbedrijf.nl</a>
        </div>
        <div class="text-center">
          <div class="text-[14px] font-medium mb-1" style="color: rgba(255,255,255,0.5);">Werkgebied</div>
          <span class="text-[16px] font-semibold text-white">Noord-Holland & omgeving</span>
        </div>
      </div>
    </div>
  </div>
</section>
